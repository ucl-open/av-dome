<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      This file is a TEMPLATE. Setup.cmd copies it to NuGet.config (git-ignored) on
      first run; edit that copy, never this one.

      GitHub Packages hosts the OpenRigs.* CI prereleases that Bonsai.config pins
      (open-rigs/open-rigs CI publishes them on every push). GitHub Packages requires
      authentication even for public packages. Pick ONE in your local NuGet.config:

        a) replace %GITHUB_PACKAGES_TOKEN% below with a personal access token that
           has the read:packages scope (the file is git-ignored, so this is safe), or
        b) leave it and set the environment variable instead:
           $env:GITHUB_PACKAGES_TOKEN = "<pat>"

      Mint a token with the GitHub CLI: gh auth refresh -s read:packages; gh auth token
    -->
    <add key="github-open-rigs" value="https://nuget.pkg.github.com/open-rigs/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <github-open-rigs>
      <add key="Username" value="open-rigs" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-open-rigs>
  </packageSourceCredentials>
</configuration>
