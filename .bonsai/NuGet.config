<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      GitHub Packages hosts the UclOpen.* CI prereleases that Bonsai.config pins
      (ucl-open/ucl-open CI publishes them on every push). GitHub Packages requires
      authentication even for public packages: set GITHUB_PACKAGES_TOKEN to a token
      with the read:packages scope before running Setup.cmd, e.g. in PowerShell

        $env:GITHUB_PACKAGES_TOKEN = "<pat>"

      or mint one with the GitHub CLI: gh auth refresh -s read:packages; gh auth token

      Keep tokens out of this file - it is tracked by git.
    -->
    <add key="github-ucl-open" value="https://nuget.pkg.github.com/ucl-open/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <github-ucl-open>
      <add key="Username" value="ucl-open" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github-ucl-open>
  </packageSourceCredentials>
</configuration>
