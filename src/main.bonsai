              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="FileName" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:FileExists" />
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>True?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>LoadSpoutPositions</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="FileName" />
                        </Expression>
                        <Expression xsi:type="io:CsvReader">
                          <io:FileName>UNMAPPED</io:FileName>
                          <io:ScanPattern>%i,%i,%i,%i,%i</io:ScanPattern>
                          <io:SkipRows>0</io:SkipRows>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor2_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor3_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item4</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item5</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="2" To="5" Label="Source1" />
                        <Edge From="2" To="7" Label="Source1" />
                        <Edge From="2" To="9" Label="Source1" />
                        <Edge From="2" To="11" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="13" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="13" Label="Source2" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="13" Label="Source3" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="13" Label="Source4" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="13" Label="Source5" />
                        <Edge From="13" To="14" Label="Source1" />
                        <Edge From="14" To="15" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>false</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>False?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="BitwiseNot" />
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor5_Position</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="14" Label="Source1" />
                  <Edge From="13" To="14" Label="Source2" />
                  <Edge From="14" To="2" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="8" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="6" To="10" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="11" Label="Source1" />
                  <Edge From="10" To="11" Label="Source2" />
                  <Edge From="11" To="12" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="1" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="1" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="1" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="1" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="1" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="1" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="1" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="1" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="1" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="1" To="24" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="1" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="1" To="28" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="1" To="30" Label="Source1" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="1" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="35" To="36" Label="Source1" />
            <Edge From="36" To="38" Label="Source1" />
            <Edge From="37" To="38" Label="Source2" />
            <Edge From="38" To="39" Label="Source1" />
            <Edge From="39" To="40" Label="Source1" />
            <Edge From="43" To="44" Label="Source1" />
            <Edge From="44" To="48" Label="Source1" />
            <Edge From="45" To="47" Label="Source1" />
            <Edge From="46" To="47" Label="Source2" />
            <Edge From="47" To="48" Label="Source2" />
            <Edge From="49" To="50" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Logging</Name>
        <Description>Everything written to the experiment folder: LogControllerLogic makes the folder at Go and publishes PathPrefix; ExperimentLogs holds every log that waits for it; BonsaiData_Async takes the controller's events and each reward from Start; RecordHarpDevices, ExperimentManifest and the Recording phase follow PathPrefix.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>LogControllerLogic</Name>
              <Description>Waits for Go (RunSettings: the controller's SubjectId and SessionId), then LogController creates the experiment folder RootPath\sub-&lt;SubjectId&gt;\ses-&lt;SessionId&gt;_&lt;DateTime&gt; and publishes it as PathPrefix, which every log waits for. RootPath is rig.yml's, the rig's acquisition folder itself (C:\Coen-Lab-Local\Acquired-Data): experiments have no project folder.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RunSettings</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="SubjectId" Selector="Item1" />
                      <Property Name="SessionId" Selector="Item2" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>RootPath</Selector>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Path" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogController.bonsai">
                    <SubjectId>UNMAPPED</SubjectId>
                    <SessionId>UNMAPPED</SessionId>
                    <Path>C:\Coen-Lab-Local\Acquired-Data</Path>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:DelaySubscription">
                      <rx:DueTime>PT1S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RunSettings</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="1" To="5" Label="Source1" />
                  <Edge From="4" To="5" Label="Source2" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="8" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="9" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogAsync.bonsai" />
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>ExperimentLogs</Name>
              <Description>Starts every experiment log once LogControllerLogic publishes PathPrefix. TrialParameters writes BonsaiData_Trial (LogTrial): one row per trial, built in ExecuteTrial when the choice is made (TrialRow, a BehaviorSubject, so the row made before the folder exists is written too; a ReplaySubject here is completed when trial 1's branch ends, and every later row is lost): what was drawn for it, the choice, its outcome, the speaker that played, and two Harp times, stimulusOnsetTime and choiceTime, with Seconds the time the outcome was known. Its columns are named and typed as the lab's list allows (K:\config\data-dictionary.json; rig-control checks before launch), and what each means (codes, units, former names) is schemas\trial-columns.yml, which ExperimentManifest copies into each experiment's manifest; settings that are the same throughout the experiment are not columns, being in the experiment's settings files (Schemas\Schemas_Rig_, Schemas_Task_ and Schemas_Experiment_&lt;DateTime&gt;.json: rig.yml as read, the task as read at Go, and from ExperimentSettings the subject, session, workflow, commit, who launched and sent Go and every ExperimentControl parameter at Go), and the RNG seed is logged once, as the RngSeed event in BonsaiData_Async. Subjects that already hold a value (BehaviorSubject, AsyncSubject) hand it to the late subscriber. Values set at startup, such as the Zapit startup replies and the first trial draw, are therefore logged when the experiment logs start, about a second after Go, with that time. Add new loggers inside this group.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>TrialParameters</Name>
                    <Description>Writes each trial's row (TrialRow, built in ExecuteTrial when the choice is made, stamped then) into BonsaiData_Trial.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TrialRow</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogTrial.bonsai" />
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoard</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>BehaviorBoard-Main.Data</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                        <Expression xsi:type="GroupWorkflow">
                          <Name>ExcludeAnalogDataMaybe</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Value" DisplayName="ExcludeAnalogData?" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="BooleanProperty">
                                  <Value>false</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Flagged</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="beh:FilterRegister">
                                <harp:FilterType>Exclude</harp:FilterType>
                                <harp:Register xsi:type="beh:AnalogData" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>NotFlagged</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="BitwiseNot" />
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="3" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source2" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="3" To="7" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="9" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                          <LogName>BehaviorBoard-Main</LogName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Cameras</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>PathPrefix</Name>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Camera-Face.Data</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Skip">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogVideo.bonsai">
                                <LogName>Camera-Face</LogName>
                                <FrameRate>50</FrameRate>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Camera-Pupil.Data</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Skip">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogVideo.bonsai">
                                <LogName>Camera-Pupil</LogName>
                                <FrameRate>50</FrameRate>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Camera-Body.Data</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Skip">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogVideo.bonsai">
                                <LogName>Camera-Body</LogName>
                                <FrameRate>50</FrameRate>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorBoard-Main</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="FrameRate" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorBoard-Main</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="FrameRate" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorBoard-Main</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="FrameRate" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                                </PropertyMappings>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="2" Label="Source2" />
                              <Edge From="11" To="12" Label="Source1" />
                              <Edge From="12" To="5" Label="Source2" />
                              <Edge From="13" To="14" Label="Source1" />
                              <Edge From="14" To="8" Label="Source2" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplit</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Left.Data</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                          <LogName>LicketySplit-Left</LogName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Right.Data</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                          <LogName>LicketySplit-Right</LogName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TimestampGeneratorGen3-Main.Data</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>TimestampGeneratorGen3-Main</LogName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p2:SerializeToJson">
                      <p2:Formatting>Indented</p2:Formatting>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
                    <Name>Schemas_Rig</Name>
                    <Extension>json</Extension>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TaskConfig</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p6:SerializeToJson">
                      <p6:Formatting>Indented</p6:Formatting>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
                    <Name>Schemas_Task</Name>
                    <Extension>json</Extension>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>ZapitReplies</Name>
                    <Description>Harp-timestamped log of every Zapit reply: the presented condition and laser state per StartStimulus, plus the last startup query reply (GetNumConditions), handed over by the ZapitReplies BehaviorSubject when ExperimentLogs starts.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>ZapitReplies</Name>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>new(
                CommandCode as command,
                Value as value,
                LaserOn as laserOn,
                IsError as isError,
                ServerDatenum as serverDatenum)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                          <Name>Timestamp</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
                          <LogName>Zapit</LogName>
                          <Selector />
                          <Extension>csv</Extension>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StepperDriver1Events</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>StepperDriver-A</LogName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StepperDriver2Events</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>StepperDriver-B</LogName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>thisTrialData</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Name>RngSeed</Name>
                    <Description>The RNG seed the experiment's trials are drawn with (the task file's rngSeed, or a random one when rngSeed is null). One InitialiseTrial draws every trial, so the seed is logged once, from the first trial, as a BonsaiData_Async event (RngSeed, its value in Value) rather than on every trial row. With the task file and the settings at Go they reproduce the experiment's draws.</Description>
                    <Selector>rngSeedUsed</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orl:CreateAsyncEvent">
                      <orl:Event>RngSeed</orl:Event>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                    <Name>Timestamp</Name>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>AsyncEvents</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>ExperimentGo</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="orcl:ExperimentSettings" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
                    <Name>Schemas_Experiment</Name>
                    <Extension>json</Extension>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="18" To="19" Label="Source1" />
                  <Edge From="20" To="21" Label="Source1" />
                  <Edge From="21" To="22" Label="Source1" />
                  <Edge From="22" To="23" Label="Source1" />
                  <Edge From="23" To="24" Label="Source1" />
                  <Edge From="24" To="25" Label="Source1" />
                  <Edge From="26" To="27" Label="Source1" />
                  <Edge From="27" To="28" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardLineLeft</Name>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Calibrated?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Calibrated</Selector>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ArtefactJson</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
              <Name>ValveCalibrationDO1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardLineRight</Name>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Calibrated?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Calibrated</Selector>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ArtefactJson</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
              <Name>ValveCalibrationDO2</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardDelivered</Name>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
              <Name>Timestamp</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>path</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Recording</orcl:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="hd:RecordHarpDevices">
              <Name>RecordHarpDevices</Name>
              <Description>Checks every Harp device in rig.yml at Start and records it into each experiment (OpenRigs.HarpDevices): the Behavior board, the timestamp generator, both stepper drivers and both Lickety Splits (each a rig.yml entry with a portName whose data the workflow publishes as &lt;Name&gt;.Data) must be on their portName with their usbSerial, or the workflow stops saying which board is where; 0.5 s after the experiment folder appears it asks each for a register dump on &lt;Name&gt;.Commands, which its log records; and it writes &lt;Name&gt;\&lt;Name&gt;_device.json and the register map &lt;Name&gt;\&lt;Name&gt;.yml, which ExperimentManifest expects (harp).</Description>
              <hd:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</hd:ConfigRoot>
            </Expression>
            <Expression xsi:type="mf:ExperimentManifest">
              <Name>ExperimentManifest</Name>
              <Description>Writes manifest.json into the experiment folder (OpenRigs.Manifest), finding PathPrefix itself: once when the folder appears and again when the workflow stops. No run is connected: an experiment ends with the controller's Stop, recorded as stopped with its reason. It records the machine, this repo's commit, Bonsai's command line, who launched it and sent Go (every parameter at Go is in Schemas_Experiment), rig.yml's path and hash, what each BonsaiData_Trial column means (schemas\trial-columns.yml, copied in at Start), and what the experiment must leave: a folder for each device in rig.yml (BehaviorBoard-Main, TimestampGeneratorGen3-Main, StepperDriver-A/B, LicketySplit-Left/Right, Camera-Face/Pupil/Body), the record and register map RecordHarpDevices writes for each Harp device (harp), each of the three settings files in Schemas (Schemas/Schemas_Rig_, Schemas/Schemas_Task_, Schemas/Schemas_Experiment_, each expected on its own) and BonsaiData (BonsaiData_Trial and BonsaiData_Async), which the overnight copy (rig-sync) alarms on if missing.</Description>
              <mf:IngestScript>av-dome</mf:IngestScript>
              <mf:ConfigFiles>C:\Coen-Lab-Local\RigConfigs\%COMPUTERNAME%\rig.yml</mf:ConfigFiles>
              <mf:ExpectedFiles>auto;harp;Schemas/Schemas_Rig_;Schemas/Schemas_Task_;Schemas/Schemas_Experiment_;BonsaiData/</mf:ExpectedFiles>
              <mf:TrialColumns>schemas\trial-columns.yml</mf:TrialColumns>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>new(&quot;RewardDelivered&quot; as Event, (it.Line == 1 ? &quot;Left&quot; : it.Line == 2 ? &quot;Right&quot; : &quot;DO&quot; + it.Line.ToString()) + &quot; requested=&quot; + it.RequestedUl.ToString() + &quot; pulses=&quot; + it.Count.ToString() + &quot; calibrated=&quot; + it.Calibrated.ToString() + &quot; clamped=&quot; + it.Clamped.ToString() as Detail, it.DeliveredUl as Value)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orl:CreateAsyncEvent">
                <orl:Event>RewardDelivered</orl:Event>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>AsyncEvents</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>new((it.Kind.ToString() == &quot;Command&quot; ? it.Name : it.Kind.ToString()) as Event, it.ToString() as Detail)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orl:CreateAsyncEvent">
                <orl:Event>Control</orl:Event>
              </Combinator>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
              <Name>Timestamp</Name>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>AsyncEvents</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="12" To="19" Label="Source1" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="13" Label="Source1" />
            <Edge From="13" To="21" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="23" To="24" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>TrialLoop</Name>
        <Description>The trial loop. DrawTrial, one InitialiseTrial for the whole experiment, draws trial 1 into thisTrialData when TaskConfig is read at Go and each later trial from the last one's outcome when its ResponseData arrives; SetTrialVars resets the per-trial state; ArmZapit and StartLaser prepare and pulse Zapit, and ExecuteTrial runs the trial, publishes its row to TrialRow when the choice is made and its ResponseData after the ITI. Runs only after Go (SubscribeWhen on StartExperiment).</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value />
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ResponseData</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>CorrectResponse</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:CombineLatest" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TrainingStage</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="trainingStageId" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Name>DrawTrial</Name>
              <Description>Draws every trial of the experiment: the first when TaskConfig is read at Go (previous outcome empty), each later one when the last trial's ResponseData arrives, after its ITI, from that outcome (repeat rules), the task configuration and the controller's TrainingStage.</Description>
              <Combinator xsi:type="p1:InitialiseTrial">
                <p1:trainingStageId>0</p1:trainingStageId>
                <p1:TrialType>-1</p1:TrialType>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>thisTrialData</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>thisTrialData</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>SetTrialVars</Name>
              <Description>Resets the per-trial state for the new trial: the visual azimuth (start and current) and the decision variable.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>visualAzimuth</Selector>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>visualAzimuthStart</Name>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>visualAzimuth</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>DecisionVariable</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>thisTrialData</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>ArmZapit</Name>
              <Description>Sends Zapit the stimulus command for an opto trial (condition, duration, delay, hardware-triggered or not); non-opto trials pass straight through.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>OptoTrial?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>OptogeneticEnabled</Selector>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="ConditionNumber" Selector="OptogeneticCondition" />
                      <Property Name="StimDuration" Selector="OptogeneticDuration" />
                      <Property Name="StartDelay" Selector="OptogeneticDelay" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="HardwareTriggered" Selector="Zapit.HardwareTriggered" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:CreateStartStimulus">
                      <p1:ConditionNumber>0</p1:ConditionNumber>
                      <p1:LaserOn>true</p1:LaserOn>
                      <p1:HardwareTriggered>true</p1:HardwareTriggered>
                      <p1:Logging>true</p1:Logging>
                      <p1:StimDuration>0</p1:StimDuration>
                      <p1:LaserPower>0</p1:LaserPower>
                      <p1:StartDelay>0</p1:StartDelay>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>ZapitCommands</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>false</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>NotOptoTrial?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>OptogeneticEnabled</Selector>
                        </Expression>
                        <Expression xsi:type="BitwiseNot" />
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>false</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Sample" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="15" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="3" To="12" Label="Source1" />
                  <Edge From="4" To="9" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="9" Label="Source2" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source3" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="14" Label="Source1" />
                  <Edge From="12" To="13" Label="Source1" />
                  <Edge From="13" To="14" Label="Source2" />
                  <Edge From="14" To="15" Label="Source3" />
                  <Edge From="15" To="16" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelay.bonsai">
              <DueSeconds>0.1</DueSeconds>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>StartLaser</Name>
              <Description>Pulses the Zapit TTL line (zapit.triggerLine) 0.1 s after arming. The condition that limits this to hardware-triggered opto trials is disabled, so every trial pulses the line.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="rx:Condition">
                      <Name>HardwareTriggeredOptoTrial?</Name>
                      <Workflow>
                        <Nodes>
                          <Expression xsi:type="WorkflowInput">
                            <Name>Source1</Name>
                          </Expression>
                          <Expression xsi:type="MemberSelector">
                            <Selector>Item1</Selector>
                          </Expression>
                          <Expression xsi:type="MemberSelector">
                            <Selector>OptogeneticEnabled</Selector>
                          </Expression>
                          <Expression xsi:type="MemberSelector">
                            <Selector>Item2</Selector>
                          </Expression>
                          <Expression xsi:type="MemberSelector">
                            <Selector>Zapit.HardwareTriggered</Selector>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:Zip" />
                          </Expression>
                          <Expression xsi:type="BitwiseAnd" />
                          <Expression xsi:type="WorkflowOutput" />
                        </Nodes>
                        <Edges>
                          <Edge From="0" To="1" Label="Source1" />
                          <Edge From="0" To="3" Label="Source1" />
                          <Edge From="1" To="2" Label="Source1" />
                          <Edge From="2" To="5" Label="Source1" />
                          <Edge From="3" To="4" Label="Source1" />
                          <Edge From="4" To="5" Label="Source2" />
                          <Edge From="5" To="6" Label="Source1" />
                          <Edge From="6" To="7" Label="Source1" />
                        </Edges>
                      </Workflow>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item2.Zapit.TriggerLine</Selector>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>TriggerPulse</Name>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="PropertyMapping">
                      <PropertyMappings>
                        <Property Name="ConditionNumber" Selector="OptogeneticCondition" />
                        <Property Name="StimDuration" Selector="OptogeneticDuration" />
                        <Property Name="StartDelay" Selector="OptogeneticDelay" />
                      </PropertyMappings>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="PropertyMapping">
                      <PropertyMappings>
                        <Property Name="HardwareTriggered" Selector="Zapit.HardwareTriggered" />
                      </PropertyMappings>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="Combinator">
                      <Combinator xsi:type="p1:CreateStartStimulus">
                        <p1:ConditionNumber>0</p1:ConditionNumber>
                        <p1:LaserOn>true</p1:LaserOn>
                        <p1:HardwareTriggered>true</p1:HardwareTriggered>
                        <p1:Logging>true</p1:Logging>
                        <p1:StimDuration>0</p1:StimDuration>
                        <p1:LaserPower>0</p1:LaserPower>
                        <p1:StartDelay>0</p1:StartDelay>
                      </Combinator>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="MulticastSubject">
                      <Name>ZapitCommands</Name>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Sample" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="13" Label="Source1" />
                  <Edge From="3" To="5" Label="Source1" />
                  <Edge From="4" To="5" Label="Source2" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="11" Label="Source1" />
                  <Edge From="9" To="11" Label="Source2" />
                  <Edge From="10" To="11" Label="Source3" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="12" To="13" Label="Source2" />
                  <Edge From="13" To="14" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelay.bonsai">
              <DueSeconds>0.5</DueSeconds>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>ExecuteTrial</Name>
              <Description>One trial: the quiescent wait, the stimulus (visual, auditory or both), the response window on the lick detectors, the consequences (reward, error sound, timeout) and the inter-trial interval; ends with the trial's response data. Each trial's stimulusOnsetTime (stamped as StartAuditoryStimulus fires) and speakerIndex (the wired speaker SpatialLookup chose) are its own subjects; BuildTrialRow makes the trial's row when Response decides the choice and publishes it to TrialRow.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>trial</Name>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject" TypeArguments="sys:String">
                    <rx:Name>StopStimuli</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
                    <rx:Name>stimulusOnsetTime</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Int32">
                    <rx:Name>speakerIndex</rx:Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>trial</Name>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>StimuliPresentation</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>settings</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Auditory Stimulus</Name>
                          <Text><![CDATA[Auditory Stimulus]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>settings</Name>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>Define Speaker location</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>thisTrialData</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>audioAzimuth</Selector>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="X" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="gl:CreateVector3">
                                  <gl:X>0</gl:X>
                                  <gl:Y>15</gl:Y>
                                  <gl:Z>0</gl:Z>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>SpeakerLocations</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Locations" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p1:SpatialLookup">
                                  <p1:Locations>
                                    <p1:Vector3>
                                      <p1:X>-90</p1:X>
                                      <p1:Y>15</p1:Y>
                                      <p1:Z>0</p1:Z>
                                    </p1:Vector3>
                                    <p1:Vector3>
                                      <p1:X>90</p1:X>
                                      <p1:Y>15</p1:Y>
                                      <p1:Z>0</p1:Z>
                                    </p1:Vector3>
                                    <p1:Vector3>
                                      <p1:X>0</p1:X>
                                      <p1:Y>15</p1:Y>
                                      <p1:Z>0</p1:Z>
                                    </p1:Vector3>
                                  </p1:Locations>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>ActiveSoundChannels</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="MulticastSubject">
                                <Name>speakerIndex</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source2" />
                              <Edge From="3" To="6" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                              <Edge From="6" To="11" Label="Source1" />
                              <Edge From="11" To="7" Label="Source1" />
                              <Edge From="7" To="9" Label="Source1" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>true</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StartAuditoryStimulus</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Visual Stimulus</Name>
                          <Text><![CDATA[Visual Stimulus]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>settings</Name>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>FlashingVisualStimulus</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:AsyncSubject">
                                <Name>trialSettings</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>DrawStimuli</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>16Hz</Name>
                                <Text><![CDATA[16Hz]]></Text>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>trialSettings</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>visualFlickerFrequency</Selector>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Double freq for On/Off</Name>
                                <Text><![CDATA[Double freq for On/Off]]></Text>
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Expression>TimeSpan.FromSeconds(1 / (2 * it))</scr:Expression>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Period" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="gl:Timer">
                                  <gl:DueTime>PT0S</gl:DueTime>
                                  <gl:Period>PT0.063S</gl:Period>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Mod">
                                <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int64">
                                  <Value>2</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item2</Selector>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Makes it 8Hz</Name>
                                <Text><![CDATA[Makes it 8Hz]]></Text>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="Equal">
                                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int64">
                                        <Value>0</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>PhotodiodeIndicator</Name>
                                <Text><![CDATA[PhotodiodeIndicator]]></Text>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawQuad.bonsai">
                                <ExtentX>30</ExtentX>
                                <ExtentY>30</ExtentY>
                                <LocationX>130</LocationX>
                                <LocationY>-22.5</LocationY>
                                <Layer>0</Layer>
                                <Angle>0</Angle>
                                <ColorR>0</ColorR>
                                <ColorG>0</ColorG>
                                <ColorB>0</ColorB>
                                <ColorA>1</ColorA>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Either Response or Timeout</Name>
                                <Text><![CDATA[Either Response or Timeout]]></Text>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StopStimuli</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:TakeUntil" />
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>GratingSettings from Schema</Name>
                                <Text><![CDATA[GratingSettings from Schema]]></Text>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>trialSettings</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Contrast" Selector="visualContrast" />
                                  <Property Name="LocationY" Selector="visualElevation" />
                                  <Property Name="TemporalFrequency" Selector="visualTemporalFrequency" />
                                  <Property Name="SpatialFrequency" Selector="visualSpatialFrequency" />
                                  <Property Name="Angle" Selector="visualOrientation" />
                                  <Property Name="Phase" Selector="visualPhase" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Extend in deg</Name>
                                <Text><![CDATA[Extend in deg]]></Text>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Large enough so you dont see any edges</Name>
                                <Text><![CDATA[Large enough so you dont see any edges]]></Text>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>100 makes rel. numbers below easier!</Name>
                                <Text><![CDATA[100 makes rel. numbers below easier!]]></Text>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="FloatProperty">
                                  <Value>100</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="ExtentX" Selector="it" />
                                  <Property Name="ExtentY" Selector="it" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>trialSettings</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>GaussianWindowSigma in deg</Name>
                                <Text><![CDATA[GaussianWindowSigma in deg]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>visualGaussianWindowSigma</Selector>
                              </Expression>
                              <Expression xsi:type="Multiply">
                                <Operand xsi:type="FloatProperty">
                                  <Value>2</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>RelativeSigma</Name>
                                <Text><![CDATA[RelativeSigma]]></Text>
                              </Expression>
                              <Expression xsi:type="Divide" />
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Aperture" Selector="it" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Norm. 1: full size of ExtentX/Y</Name>
                                <Text><![CDATA[Norm. 1: full size of ExtentX/Y]]></Text>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="FloatProperty">
                                  <Value>1</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Radius" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>visualAzimuth</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="LocationX" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawGratings.bonsai">
                                <LocationX>0</LocationX>
                                <LocationY>0</LocationY>
                                <Layer>0</Layer>
                                <ExtentX>100</ExtentX>
                                <ExtentY>100</ExtentY>
                                <SpatialFrequency>0.06666667</SpatialFrequency>
                                <TemporalFrequency>0</TemporalFrequency>
                                <Phase>298.032227</Phase>
                                <Angle>0</Angle>
                                <SquareWave>false</SquareWave>
                                <Contrast>0</Contrast>
                                <DutyCycle xsi:nil="true" />
                                <Radius>1</Radius>
                                <Aperture>0.4</Aperture>
                                <Opacity>1</Opacity>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:TakeUntil" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Not</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="Equal">
                                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int64">
                                        <Value>0</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="BitwiseNot" />
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>PhotodiodeIndicator</Name>
                                <Text><![CDATA[PhotodiodeIndicator]]></Text>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawQuad.bonsai">
                                <ExtentX>30</ExtentX>
                                <ExtentY>30</ExtentY>
                                <LocationX>130</LocationX>
                                <LocationY>-22.5</LocationY>
                                <Layer>0</Layer>
                                <Angle>0</Angle>
                                <ColorR>1</ColorR>
                                <ColorG>1</ColorG>
                                <ColorB>1</ColorB>
                                <ColorA>1</ColorA>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:TakeUntil" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Done</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>StopStimuli</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
