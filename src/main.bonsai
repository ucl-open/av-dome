                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor2_switchState</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperDriver2Events</Name>
                              </Expression>
                              <Expression xsi:type="p3:Parse">
                                <harp:Register xsi:type="p3:DigitalInputState" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p1:UnpackSwitchTriggers" />
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor3_switchState</Name>
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>1</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor4_switchState</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="2" To="5" Label="Source1" />
                              <Edge From="2" To="7" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                              <Edge From="11" To="12" Label="Source1" />
                              <Edge From="11" To="14" Label="Source1" />
                              <Edge From="12" To="13" Label="Source1" />
                              <Edge From="14" To="15" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>ZEROMotors</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor0_switchState</SubjectName_switchState>
                                <MotorID>0</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor0_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor1_switchState</SubjectName_switchState>
                                <MotorID>1</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor1_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor2_switchState</SubjectName_switchState>
                                <MotorID>2</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor2_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor3_switchState</SubjectName_switchState>
                                <MotorID>0</MotorID>
                                <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor3_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor4_switchState</SubjectName_switchState>
                                <MotorID>1</MotorID>
                                <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor4_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelay.bonsai">
                                <DueSeconds>2</DueSeconds>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="BooleanProperty">
                                  <Value>true</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>SteppersZEROed</Name>
                              </Expression>
                              <Expression xsi:type="rx:SelectMany">
                                <Name>SendSpoutInCommand</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="Annotation">
                                      <Name>MoveToInPosition</Name>
                                      <Text><![CDATA[MoveToInPosition]]></Text>
                                    </Expression>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>StepperPosition_BothIn</Name>
                                    </Expression>
                                    <Expression xsi:type="MulticastSubject">
                                      <Name>StepperPositionCommand</Name>
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="rx:Sample" />
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="4" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                    <Edge From="3" To="4" Label="Source2" />
                                    <Edge From="4" To="5" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Motor0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Motor1</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Motor2</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Motor3</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Motor4</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>AllZeroed</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>HarpDelay</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperDriversInitialized</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>StepperDriversInitialized</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Timestamp</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="StringProperty">
                                  <Value>Timestamp</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p1:StartupWatchdog">
                                  <p1:Expected>StepperDriversInitialized, Timestamp, Motor0, Motor1, Motor2, Motor3, Motor4, AllZeroed, HarpDelay</p1:Expected>
                                  <p1:TimeoutSeconds>60</p1:TimeoutSeconds>
                                  <p1:What>Zeroing the spout steppers (needed for Ready)</p1:What>
                                </Combinator>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="5" Label="Source1" />
                              <Edge From="1" To="5" Label="Source2" />
                              <Edge From="2" To="5" Label="Source3" />
                              <Edge From="3" To="5" Label="Source4" />
                              <Edge From="4" To="5" Label="Source5" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="8" To="9" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="0" To="11" Label="Source1" />
                              <Edge From="1" To="12" Label="Source1" />
                              <Edge From="2" To="13" Label="Source1" />
                              <Edge From="3" To="14" Label="Source1" />
                              <Edge From="4" To="15" Label="Source1" />
                              <Edge From="5" To="16" Label="Source1" />
                              <Edge From="6" To="17" Label="Source1" />
                              <Edge From="18" To="19" Label="Source1" />
                              <Edge From="19" To="20" Label="Source1" />
                              <Edge From="21" To="22" Label="Source1" />
                              <Edge From="22" To="23" Label="Source1" />
                              <Edge From="20" To="24" Label="Source1" />
                              <Edge From="23" To="24" Label="Source2" />
                              <Edge From="11" To="24" Label="Source3" />
                              <Edge From="12" To="24" Label="Source4" />
                              <Edge From="13" To="24" Label="Source5" />
                              <Edge From="14" To="24" Label="Source6" />
                              <Edge From="15" To="24" Label="Source7" />
                              <Edge From="16" To="24" Label="Source8" />
                              <Edge From="17" To="24" Label="Source9" />
                              <Edge From="24" To="25" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperPositionCommand</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\MoveStepperMotors.bonsai" />
                        <Expression xsi:type="SubscribeSubject">
                          <Name>SteppersZEROed</Name>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:SubscribeWhen" />
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="11" Label="Source1" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source2" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Zapit</Name>
                    <Description>Connects to the Zapit optogenetics server only when the task YAML enables optogenetics. Commands arrive on ZapitCommands, replies leave on ZapitReplies.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskConfig</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>TaskParameters.Optogenetics.Enabled</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:Condition">
                          <Name>OptogeneticsEnabled?</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>ConnectZapit</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>RigConfigs</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Host" Selector="Zapit.Host" />
                                  <Property Name="Port" Selector="Zapit.Port" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\Zapit.bonsai">
                                <Host>127.0.0.1</Host>
                                <Port>1488</Port>
                                <ReceiveTimeout>5000</ReceiveTimeout>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Settings.PulseController.Outputs.DO3</Selector>
                  </Expression>
                  <Expression xsi:type="p2:MatchPulseOutput">
                    <p2:Type xsi:type="TypeMapping" TypeArguments="p2:FixedPulse" />
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PulseDO3" Selector="PulseWidthMs" />
                    </PropertyMappings>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="18" To="10" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="FileName" Selector="ProjectionCalibration.MeshMapPath" />
                <Property Name="GammaLut" Selector="ProjectionCalibration.GammaLutPath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="DisplayDevice" />
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>BonvisionResources</Name>
              <Description>BonVision's window, mesh mapping and gamma correction for the dome projector, from projectionCalibration in rig.yml; DisplayDevice is a launch property.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="DisplayDevice" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:CreateWindow">
                      <gl:Width>1920</gl:Width>
                      <gl:Height>1080</gl:Height>
                      <gl:VSync>On</gl:VSync>
                      <gl:SwapSync>false</gl:SwapSync>
                      <gl:ClearColor>Gray</gl:ClearColor>
                      <gl:ClearMask>DepthBufferBit ColorBufferBit</gl:ClearMask>
                      <gl:CursorVisible>false</gl:CursorVisible>
                      <gl:Location xsi:nil="true" />
                      <gl:WindowBorder>Fixed</gl:WindowBorder>
                      <gl:WindowState>Fullscreen</gl:WindowState>
                      <gl:DisplayDevice>First</gl:DisplayDevice>
                      <gl:TargetRenderFrequency>60</gl:TargetRenderFrequency>
                      <gl:TargetUpdateFrequency>60</gl:TargetUpdateFrequency>
                      <gl:RenderState />
                      <gl:GraphicsMode>
                        <gl:ColorFormat>
                          <gl:Red>8</gl:Red>
                          <gl:Green>8</gl:Green>
                          <gl:Blue>8</gl:Blue>
                          <gl:Alpha>8</gl:Alpha>
                        </gl:ColorFormat>
                        <gl:Depth>16</gl:Depth>
                        <gl:Stencil>0</gl:Stencil>
                        <gl:Samples>0</gl:Samples>
                        <gl:AccumulatorFormat>
                          <gl:Red>0</gl:Red>
                          <gl:Green>0</gl:Green>
                          <gl:Blue>0</gl:Blue>
                          <gl:Alpha>0</gl:Alpha>
                        </gl:AccumulatorFormat>
                        <gl:Buffers>2</gl:Buffers>
                        <gl:Stereo>false</gl:Stereo>
                      </gl:GraphicsMode>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.BonVisionResources.bonsai" />
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="res:LoadResources" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:RenderFrame" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.OrthographicView.bonsai">
                    <Left>-135</Left>
                    <Right>135</Right>
                    <Bottom>-22.5</Bottom>
                    <Top>82.5</Top>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>DrawStimuli</Name>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="FileName" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.MeshMapping.bonsai">
                    <ClearColor>Gray</ClearColor>
                    <FileName>C:\RigConfigs\MeshMap.csv</FileName>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="GammaLut" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.GammaCorrection.bonsai">
                    <ClearColor>Gray</ClearColor>
                    <GammaLut>C:\RigConfigs\gammalut.bmp</GammaLut>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="8" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="10" Label="Source1" />
                  <Edge From="9" To="10" Label="Source2" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:DisposeOnRenderThread">
                <p1:TimeoutSeconds>2</p1:TimeoutSeconds>
              </Combinator>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Audio</Name>
              <Description>The speaker mixer (speakerArray.device in rig.yml), the auditory stimulus set and speaker filters from the rig's calibration folder, the error sound and the background noise, and PlayStim, which plays each trial's stimulus on its speaker with a copy on the sync channel.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LoadAudioFiles</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>SpeakerArray</Selector>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigDirectory</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:LoadAuditoryStimulusSet">
                            <p1:Folder>calibration\AuditoryStimuli</p1:Folder>
                            <p1:FilePrefix>filtered_pink_pulse_train_</p1:FilePrefix>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>AuditoryStimulusSet</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>AuditoryStimulusSet</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>WaveformLength</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="BufferLength" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:FunctionGenerator">
                            <dsp:BufferLength>72000</dsp:BufferLength>
                            <dsp:Frequency>0</dsp:Frequency>
                            <dsp:Waveform>Square</dsp:Waveform>
                            <dsp:SampleRate>48000</dsp:SampleRate>
                            <dsp:Amplitude>0</dsp:Amplitude>
                            <dsp:Offset>1</dsp:Offset>
                            <dsp:Phase>0</dsp:Phase>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>PinkNoiseSync</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>TaskConfig</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>TaskParameters.ErrorSound.Path</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="FileName" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="al:AudioReader">
                            <al:FileName>LocalFiles\error_tone.wav</al:FileName>
                            <al:BufferLength>0</al:BufferLength>
                            <al:SampleRate>0</al:SampleRate>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:Rescale">
                            <dsp:Min>-32768</dsp:Min>
                            <dsp:Max>32768</dsp:Max>
                            <dsp:RangeMin>-1</dsp:RangeMin>
                            <dsp:RangeMax>1</dsp:RangeMax>
                            <dsp:RescaleType>Linear</dsp:RescaleType>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="dsp:ConvertScale">
                            <dsp:Depth>F32</dsp:Depth>
                            <dsp:Scale>0.5</dsp:Scale>
                            <dsp:Shift>0</dsp:Shift>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>waveformErrorSound</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="al:AudioReader">
