                        <Edge From="9" To="15" Label="Source2" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="13" Label="Source1" />
                        <Edge From="13" To="14" Label="Source1" />
                        <Edge From="14" To="15" Label="Source3" />
                        <Edge From="15" To="16" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="rx:Defer">
                    <Name>PlayBackground</Name>
                    <Description>Background white noise for the whole workflow, looping from 2 s after start on every wired speaker in rig.yml (speakerArray.speakers), never on the sync or unused channels.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>waveformBackground</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>ChannelCount</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="ChannelCount" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:Broadcast">
                            <p1:ChannelCount>32</p1:ChannelCount>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>AuditoryStimulusSet</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>SpeakerChannels</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Channels" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:ChannelActivation">
                            <p1:Channels>
                              <p1:int>0</p1:int>
                            </p1:Channels>
                            <p1:Gain>
                              <p1:double>1</p1:double>
                            </p1:Gain>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="4" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source2" />
                        <Edge From="4" To="8" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source2" />
                        <Edge From="8" To="9" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>MixerBufferBackgroundSound</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:DelaySubscription">
                      <rx:DueTime>PT2S</rx:DueTime>
                    </Combinator>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="13" To="14" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="17" To="18" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>RewardLines</Name>
              <Description>Builds the left (DO1) and right (DO2) reward lines from the rig configuration: a calibrated line reads and fits its valve calibration from the rig configuration directory, a fixed line keeps its width. The Logging group snapshots each calibration read into the experiment folder.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Settings.PulseController.Outputs.DO1</Selector>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigDirectory</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:LoadRewardLine">
                      <p1:Line>1</p1:Line>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>RewardLineLeft</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>BehaviorBoard-Main</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Settings.PulseController.Outputs.DO2</Selector>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigDirectory</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:LoadRewardLine">
                      <p1:Line>2</p1:Line>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>RewardLineRight</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="3" Label="Source1" />
                  <Edge From="2" To="3" Label="Source2" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="10" Label="Source1" />
                  <Edge From="9" To="10" Label="Source2" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="12" To="13" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>StepperDriver</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:RigDevice">
                <p2:Name>StepperDriver-B</p2:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>StepperDriver-B</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="33" To="34" Label="Source1" />
            <Edge From="34" To="35" Label="Source1" />
            <Edge From="37" To="38" Label="Source1" />
            <Edge From="38" To="40" Label="Source1" />
            <Edge From="39" To="40" Label="Source2" />
            <Edge From="40" To="41" Label="Source1" />
            <Edge From="44" To="45" Label="Source1" />
            <Edge From="45" To="46" Label="Source1" />
            <Edge From="46" To="47" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Declarations</Name>
        <Description>Experiment-wide subjects the other groups share: TrialCount (from 0), TrialRow (each trial's BonsaiData_Trial row, built in ExecuteTrial when the choice is made and replayed to the experiment logs), whether the steppers are zeroed, the decision variable, the visual azimuth (start and current), and the Zapit command and reply streams.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>TrialCount</Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
              <rx:Name>SteppersZEROed</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Int32">
              <rx:Name>DecisionVariable</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
              <rx:Name>visualAzimuthStart</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Double">
              <rx:Name>visualAzimuth</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="p1:ZapitCommand">
              <rx:Name>ZapitCommands</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="p1:ZapitReply">
              <rx:Name>ZapitReplies</rx:Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:Timestamped(p1:TrialRow)">
              <rx:Name>TrialRow</rx:Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SubjectId" Description="The mouse; the launch's own, from rig-control." />
        <Property Name="SessionId" Description="The session number; the launch's own, from rig-control." />
        <Property Name="TaskPath" Description="The task file read at Go: rig-control's copy of the one chosen at launch, with the form's edits (lib-open-rigs settings-files plan); from the editor, config\task.yml." />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Initialization</Name>
        <Description>The experiment controller (OpenRigs.Control, ExperimentControl), in place of the Bonsai.Gui window: SubjectId (the mouse) and SessionId from this node's properties or the command line (--property:SubjectId=...), the settings a controller may change until Go (TrainingStage, ManualRewardUl, StepSize; the task's own settings are the task file's, which rig-control writes at Go and names in TaskPath) and the commands it may send while ready or recording, over TCP 5561 (the rig agent relays). The workflow starts into ready mode: devices connected, spouts zeroed and at this mouse's positions, live view streaming, nothing recorded, and reports Ready once the steppers are zeroed. Go publishes RunSettings (SubjectId, SessionId, TrainingStage), which logging and the trial loop wait for, sets StartExperiment true (the old Start button), and names the task file (TaskFilePath, from TaskPath). SubjectId is also published at Start, for this mouse's spout positions file. StepSize follows the controller live (StepperStepSize); RewardUl is what RewardLeft and RewardRight deliver: ManualRewardUl (3 ul unless set) until the first trial gives its size.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="SubjectId" Description="The subject (mouse) ID." />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value></Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SessionId" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="SubjectId" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Control:ExperimentControl.bonsai">
              <SubjectId>UNMAPPED</SubjectId>
              <SessionId />
              <ControlEndpoint>@tcp://127.0.0.1:5561</ControlEndpoint>
              <Parameters>
                <Parameter>
                  <Name>TrainingStage</Name>
                  <Value>4</Value>
                  <Description>Row of the task file's trainingStages to run, 0 to 5 (a row past the end uses the last): the GUI's Training Stage.</Description>
                  <Minimum>0</Minimum>
                  <Maximum>5</Maximum>
                  <WholeNumber>true</WholeNumber>
                </Parameter>
                <Parameter>
                  <Name>ManualRewardUl</Name>
                  <Value>3</Value>
                  <Description>Microlitres RewardLeft and RewardRight deliver before Go, taken live; after Go a manual reward is the current trial's size. The task's own reward sizes are the task file's (trainingStages rewardSizeUl).</Description>
                  <Minimum>0</Minimum>
                </Parameter>
                <Parameter>
                  <Name>StepSize</Name>
                  <Value>150</Value>
                  <Description>Motor steps each spout nudge command moves, taken live while ready.</Description>
                  <Minimum>1</Minimum>
                  <WholeNumber>true</WholeNumber>
                </Parameter>
              </Parameters>
              <Commands>
                <Command>
                  <Name>RewardLeft</Name>
                  <Description>Deliver one reward on the left spout (flush).</Description>
                </Command>
                <Command>
                  <Name>RewardRight</Name>
                  <Description>Deliver one reward on the right spout (flush).</Description>
                </Command>
                <Command>
                  <Name>SpoutsHome</Name>
                  <Description>Move both spouts to the home position.</Description>
                </Command>
                <Command>
                  <Name>SpoutsIn</Name>
                  <Description>Move both spouts to the in position.</Description>
                </Command>
                <Command>
                  <Name>SpoutsOut</Name>
                  <Description>Move both spouts to the out position.</Description>
                </Command>
                <Command>
                  <Name>SaveSpoutPositions</Name>
                  <Description>Save the spouts' in positions to this mouse's file.</Description>
                </Command>
                <Command>
                  <Name>LeftUp</Name>
                  <Description>Nudge the left spout up by StepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftDown</Name>
                  <Description>Nudge the left spout down by StepSize.</Description>
                </Command>
                <Command>
                  <Name>RightUp</Name>
                  <Description>Nudge the right spout up by StepSize.</Description>
                </Command>
                <Command>
                  <Name>RightDown</Name>
                  <Description>Nudge the right spout down by StepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftFront</Name>
                  <Description>Nudge the left spout forward by StepSize.</Description>
                </Command>
                <Command>
                  <Name>LeftBack</Name>
                  <Description>Nudge the left spout back by StepSize.</Description>
                </Command>
                <Command>
                  <Name>RightFront</Name>
                  <Description>Nudge the right spout forward by StepSize.</Description>
                </Command>
                <Command>
                  <Name>RightBack</Name>
                  <Description>Nudge the right spout back by StepSize.</Description>
                </Command>
                <Command>
                  <Name>BaseLeft</Name>
                  <Description>Nudge the spout base left by StepSize.</Description>
                </Command>
                <Command>
                  <Name>BaseRight</Name>
                  <Description>Nudge the spout base right by StepSize.</Description>
                </Command>
              </Commands>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SubjectId</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>SessionId</Selector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ParameterValue">
                <orcl:Name>TrainingStage</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>StageToInt</scr:Name>
              <scr:Expression>Convert.ToInt32(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>RunSettingsValid</Name>
              <Description>Subject and session given; the stage's limits are the parameter's.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>Item1.Trim().Length &gt; 0 &amp;&amp; Item2.Trim().Length &gt; 0</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:First" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RunSettings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RunSettings</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item3</Selector>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TrainingStage</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>..\config\task.yml</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskFilePath</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>false</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>StartExperiment</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ExperimentGo</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>true</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>StartExperiment</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>150</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>StepperStepSize</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnParameterSet">
                <orcl:Name>StepSize</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>StepSizeToInt</scr:Name>
              <scr:Expression>Convert.ToInt32(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>StepperStepSize</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="DoubleProperty">
                <Value>3</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>RewardUl</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnParameterSet">
                <orcl:Name>ManualRewardUl</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Given?</Name>
              <Description>A blank set keeps the size as it was.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>it.Trim().Length &gt; 0</scr:Expression>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Name>RewardToDouble</scr:Name>
              <scr:Expression>Convert.ToDouble(it)</scr:Expression>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>RewardUl</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SteppersZEROed</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Ready</orcl:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="TaskPath" Description="The task file read at Go: rig-control's copy of the one chosen at launch, with the form's edits; from the editor, config\task.yml." />
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="4" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="7" To="9" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="11" To="17" Label="Source1" />
            <Edge From="13" To="17" Label="Source2" />
            <Edge From="16" To="17" Label="Source3" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="19" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="23" To="24" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="27" To="28" Label="Source1" />
            <Edge From="29" To="30" Label="Source1" />
            <Edge From="31" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="34" To="35" Label="Source1" />
            <Edge From="36" To="37" Label="Source1" />
            <Edge From="37" To="38" Label="Source1" />
            <Edge From="38" To="39" Label="Source1" />
            <Edge From="40" To="41" Label="Source1" />
            <Edge From="42" To="43" Label="Source1" />
            <Edge From="43" To="44" Label="Source1" />
            <Edge From="44" To="45" Label="Source1" />
            <Edge From="45" To="46" Label="Source1" />
            <Edge From="47" To="48" Label="Source1" />
            <Edge From="48" To="49" Label="Source1" />
            <Edge From="50" To="26" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>InitialiseTrials</Name>
        <Description>At Go: reads the task file (TaskPath, as rig-control wrote it) and publishes TaskConfig. Declares thisTrialData, the current trial, which TrialLoop's DrawTrial fills.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Name>Read task configuration</Name>
              <Text><![CDATA[At Go: the task file named by TaskPath is read, as rig-control wrote it at Go (the file chosen at launch, with the form's edits and any null rngSeed drawn, checked against the task schema; lib-open-rigs settings-files plan), then published as TaskConfig and written to the experiment as Schemas\Schemas_Task_<DateTime>.json. Nothing is read before Go. From the editor TaskPath is config\task.yml, as it is.]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskFilePath</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:ReadTextFile" />
            </Expression>
            <Expression xsi:type="p6:DeserializeFromYaml">
              <p6:Type xsi:type="TypeMapping" TypeArguments="p6:UclOpenAvDomeTaskLogic" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject" TypeArguments="p1:Trial">
              <rx:Name>thisTrialData</rx:Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Status</Name>
        <Description>The current trial's facts, reported to the controller as metrics (ReportMetric; the latest value of each is in status), named as BonsaiData_Trial's columns: target, trialType, visualAzimuth, audioAzimuth (as drawn; the row has the speaker that played) and rewardSizeUl. Counts, water, licks and performance are not computed here: rig-control computes them from BonsaiData_Trial, BonsaiData_Async and the LicketySplit lick files (register 32). Also sets RewardUl, the size a manual reward uses.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>thisTrialData</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>targetSide</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>target</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>trialType</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>trialType</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>visualAzimuth</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>visualAzimuth</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>audioAzimuth</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>audioAzimuth</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>RewardSizeInUl</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>rewardSizeUl</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>RewardSizeInUl</Selector>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>RewardUl</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="0" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="0" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="0" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="0" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="0" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Commands</Name>
        <Description>The controller's commands, while ready or recording: rewards (flushes) on either spout, the spouts home, in and out, nudging each spout and the base by StepSize, and saving this mouse's spout positions. The valve and stepper logic is the old GUI's; only its sources changed, from buttons to OnCommand.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Name>Commands</Name>
              <Text><![CDATA[Each command the controller may send (declared on ExperimentControl) raises the subject the valve and stepper logic below already listens to. Spout nudges pair as the GUI's buttons did: Left/Right Up/Down are motors 4/5, Left/Right Front/Back motors 2/3, Base Left/Right motor 1.]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RewardLeft</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>RewardLeft</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RewardRight</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>RewardRight</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsHome</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsHome</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsIn</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsIn</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SpoutsOut</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SpoutsOut</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>SaveSpoutPositions</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>SaveSpoutPositions</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftUp</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftDown</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightUp</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightDown</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftFront</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor2_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>LeftBack</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor2_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightFront</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor3_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>RightBack</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor3_DOWN</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>BaseLeft</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor1_UP</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:OnCommand">
                <orcl:Name>BaseRight</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor1_DOWN</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Name>Spout positions file</Name>
              <Text><![CDATA[This mouse's spout positions: <RigConfigDirectory>\calibration\LickSpoutPositions\<SubjectId>.csv, read at Start (ReadPositions) and written by SaveSpoutPositions.]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigDirectory</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it + "\\calibration\\LickSpoutPositions\\"</scr:Expression>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SubjectId</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>it.Item1 + it.Item2 + ".csv"</scr:Expression>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>SpoutPositionFileName</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>ValveCommands</Name>
              <Description>ValveGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardLeft</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>1</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardRight</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>2</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RewardUl</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:WithLatestFrom" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>DeliverRewardCommand</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="1" To="4" Label="Source1" />
                  <Edge From="3" To="4" Label="Source2" />
                  <Edge From="4" To="6" Label="Source1" />
                  <Edge From="5" To="6" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>StepperCommands</Name>
              <Description>StepperMotorGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Annotation">
                    <Name>Update Motor IN position data</Name>
                    <Text><![CDATA[Update Motor IN position data]]></Text>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Position Update</Name>
                    <Description>Position Update</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Annotation">
                          <Name>Motor1_IN_position</Name>
                          <Text><![CDATA[Motor1_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor2_IN_position</Name>
                          <Text><![CDATA[Motor2_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor2_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor3_IN_position</Name>
                          <Text><![CDATA[Motor3_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor3_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor4_IN_position</Name>
                          <Text><![CDATA[Motor4_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor5_IN_position</Name>
                          <Text><![CDATA[Motor5_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Grab all latest inputs</Name>
                          <Text><![CDATA[Grab all latest inputs]]></Text>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Store IN position</Name>
                          <Text><![CDATA[Store IN position]]></Text>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Sends command with every update</Name>
                          <Text><![CDATA[Sends command with every update]]></Text>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>Send command when experiment not running</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StartExperiment</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Send Command?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="BitwiseNot" />
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>StepperPositionCommand</Name>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Don't send?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="2" To="6" Label="Source1" />
                              <Edge From="2" To="9" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="8" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source2" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>Init Positions</Name>
                          <Description>Init Positions</Description>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>RigConfigs</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>LickSpoutDefaultPosition</Selector>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Motor1_IN_position</Name>
                                <Text><![CDATA[Motor1_IN_position]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>LeftElevation</Selector>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Motor1_Position</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Motor2_IN_position</Name>
                                <Text><![CDATA[Motor2_IN_position]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>RightElevation</Selector>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Motor2_Position</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Motor3_IN_position</Name>
                                <Text><![CDATA[Motor3_IN_position]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>RightRadial</Selector>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Motor3_Position</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Motor4_IN_position</Name>
                                <Text><![CDATA[Motor4_IN_position]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>LeftRadial</Selector>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Motor4_Position</Name>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Motor5_IN_position</Name>
                                <Text><![CDATA[Motor5_IN_position]]></Text>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>BaseTransverse</Selector>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Motor5_Position</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="3" Label="Source1" />
                              <Edge From="1" To="6" Label="Source1" />
                              <Edge From="1" To="9" Label="Source1" />
                              <Edge From="1" To="12" Label="Source1" />
                              <Edge From="1" To="15" Label="Source1" />
                              <Edge From="2" To="3" Label="Source2" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="17" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="17" Label="Source2" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="17" Label="Source3" />
                              <Edge From="11" To="12" Label="Source2" />
                              <Edge From="12" To="13" Label="Source1" />
                              <Edge From="13" To="17" Label="Source4" />
                              <Edge From="14" To="15" Label="Source2" />
                              <Edge From="15" To="16" Label="Source1" />
                              <Edge From="16" To="17" Label="Source5" />
                              <Edge From="17" To="18" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:SubscribeWhen" />
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>SteppersZEROed</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:SubscribeWhen" />
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor1_IN_position</Name>
                          <Text><![CDATA[Motor1_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor2_IN_position</Name>
                          <Text><![CDATA[Motor2_IN_position]]></Text>
                        </Expression>
