                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="Subtract" />
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="2" Label="Source2" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="6" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="4" To="13" Label="Source1" />
                        <Edge From="5" To="6" Label="Source2" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="9" To="11" Label="Source1" />
                        <Edge From="10" To="11" Label="Source2" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="14" Label="Source1" />
                        <Edge From="13" To="14" Label="Source2" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="15" To="16" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="StepSize" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Motor5</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_UP</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Value" DisplayName="StepSize" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="IntProperty">
                            <Value>150</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="Add" />
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_DOWN</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="IntProperty">
                            <Value>150</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:WithLatestFrom" />
                        </Expression>
                        <Expression xsi:type="Subtract" />
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="2" Label="Source2" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="6" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="4" To="13" Label="Source1" />
                        <Edge From="5" To="6" Label="Source2" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="9" To="11" Label="Source1" />
                        <Edge From="10" To="11" Label="Source2" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="14" Label="Source1" />
                        <Edge From="13" To="14" Label="Source2" />
                        <Edge From="14" To="15" Label="Source1" />
                        <Edge From="15" To="16" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="5" To="8" Label="Source1" />
                  <Edge From="5" To="10" Label="Source1" />
                  <Edge From="5" To="12" Label="Source1" />
                  <Edge From="5" To="14" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="12" To="13" Label="Source1" />
                  <Edge From="14" To="15" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SpoutPositionFileName</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="FileName" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SaveSpoutPositions</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SpoutPositionFileName</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:SubscribeWhen" />
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>WritePositions</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor1_Position</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor2_Position</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor3_Position</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor4_Position</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>Motor5_Position</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="Format">
                    <Format>{0},{1},{2},{3},{4}</Format>
                    <Selector>Item1,Item2,Item3,Item4,Item5</Selector>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="FileName" />
                  </Expression>
                  <Expression xsi:type="io:CsvWriter">
                    <io:FileName>UNMAPPED</io:FileName>
                    <io:Delimiter>,</io:Delimiter>
                    <io:ListSeparator>;</io:ListSeparator>
                    <io:Append>false</io:Append>
                    <io:Overwrite>true</io:Overwrite>
                    <io:Suffix>None</io:Suffix>
                    <io:IncludeHeader>false</io:IncludeHeader>
                    <io:Selector>it</io:Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="1" To="6" Label="Source1" />
                  <Edge From="2" To="6" Label="Source2" />
                  <Edge From="3" To="6" Label="Source3" />
                  <Edge From="4" To="6" Label="Source4" />
                  <Edge From="5" To="6" Label="Source5" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="9" Label="Source1" />
                  <Edge From="8" To="9" Label="Source2" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>SpoutPositionFileName</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>ReadPositions</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="FileName" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>_fName</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:FileExists" />
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>True?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>LoadSpoutPositions</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="FileName" />
                        </Expression>
                        <Expression xsi:type="io:CsvReader">
                          <io:FileName>UNMAPPED</io:FileName>
                          <io:ScanPattern>%i,%i,%i,%i,%i</io:ScanPattern>
                          <io:SkipRows>0</io:SkipRows>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item1</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item2</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor2_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item3</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor3_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item4</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>Item5</Selector>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="2" To="5" Label="Source1" />
                        <Edge From="2" To="7" Label="Source1" />
                        <Edge From="2" To="9" Label="Source1" />
                        <Edge From="2" To="11" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="13" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="13" Label="Source2" />
                        <Edge From="7" To="8" Label="Source1" />
                        <Edge From="8" To="13" Label="Source3" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="13" Label="Source4" />
                        <Edge From="11" To="12" Label="Source1" />
                        <Edge From="12" To="13" Label="Source5" />
                        <Edge From="13" To="14" Label="Source1" />
                        <Edge From="14" To="15" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>false</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:Condition">
                    <Name>False?</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="BitwiseNot" />
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="8" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="6" To="10" Label="Source1" />
                  <Edge From="7" To="8" Label="Source2" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="9" To="11" Label="Source1" />
                  <Edge From="10" To="11" Label="Source2" />
                  <Edge From="11" To="12" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="1" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="1" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="1" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="1" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="1" To="14" Label="Source1" />
            <Edge From="14" To="15" Label="Source1" />
            <Edge From="1" To="16" Label="Source1" />
            <Edge From="16" To="17" Label="Source1" />
            <Edge From="1" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="1" To="20" Label="Source1" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="1" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="1" To="24" Label="Source1" />
            <Edge From="24" To="25" Label="Source1" />
            <Edge From="1" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="1" To="28" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="1" To="30" Label="Source1" />
            <Edge From="30" To="31" Label="Source1" />
            <Edge From="1" To="32" Label="Source1" />
            <Edge From="32" To="33" Label="Source1" />
            <Edge From="35" To="36" Label="Source1" />
            <Edge From="36" To="38" Label="Source1" />
            <Edge From="37" To="38" Label="Source2" />
            <Edge From="38" To="39" Label="Source1" />
            <Edge From="39" To="40" Label="Source1" />
            <Edge From="43" To="44" Label="Source1" />
            <Edge From="44" To="48" Label="Source1" />
            <Edge From="45" To="47" Label="Source1" />
            <Edge From="46" To="47" Label="Source2" />
            <Edge From="47" To="48" Label="Source2" />
            <Edge From="49" To="50" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Logging</Name>
        <Description>Everything written to the session folder: LogControllerLogic makes the folder at Go and publishes PathPrefix; SessionLogs holds every log that waits for it; BonsaiData_Async takes the controller's events and each reward from Start; RecordHarpDevices, SessionManifest and the Recording phase follow PathPrefix.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>LogControllerLogic</Name>
              <Description>Waits for Go (RunSettings: the controller's SubjectId and SessionId), then LogController creates the session folder RootPath\DatasetName\sub-&lt;SubjectId&gt;\ses-&lt;SessionId&gt;_&lt;DateTime&gt; and publishes it as PathPrefix, which every log waits for. DatasetName is the task file's, so TaskConfig must have been read (at Go).</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RunSettings</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="SubjectId" Selector="Item1" />
                      <Property Name="SessionId" Selector="Item2" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>RootPath</Selector>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TaskConfig</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>TaskParameters.DatasetName</Selector>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="scr:ExpressionTransform">
                    <scr:Expression>Item1 + "\\" + Item2</scr:Expression>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="Path" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogController.bonsai">
                    <SubjectId>UNMAPPED</SubjectId>
                    <SessionId>UNMAPPED</SessionId>
                    <Path>C:\data\AV_Dome</Path>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:DelaySubscription">
                      <rx:DueTime>PT1S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RunSettings</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:SubscribeWhen" />
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="3" To="6" Label="Source1" />
                  <Edge From="5" To="6" Label="Source2" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="1" To="9" Label="Source1" />
                  <Edge From="8" To="9" Label="Source2" />
                  <Edge From="9" To="10" Label="Source1" />
                  <Edge From="10" To="12" Label="Source1" />
                  <Edge From="11" To="12" Label="Source2" />
                  <Edge From="12" To="13" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>StartAuditoryStimulus</Name>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
              <Name>Timestamp</Name>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>StimulusOnset</Name>
              <Description>Each stimulus onset (StartAuditoryStimulus) with the Harp time it fired at, stamped here, from Ready, so the session logs, which start once the session folder exists after trial 1 has begun, read trial 1's true time instead of the time they subscribed.</Description>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogAsync.bonsai" />
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>SessionLogs</Name>
              <Description>Starts every session log once LogControllerLogic publishes PathPrefix. TrialParameters writes BonsaiData_Trial (LogTrial): one row per trial, its settings and outcome together, with stimulusOnsetSeconds, the Harp time of that trial's stimulus onset (StimulusOnset; NaN until the first). Subjects that already hold a value (BehaviorSubject, AsyncSubject) hand it to the late subscriber. Values set at startup, such as the Zapit startup replies and the first trial draw, are therefore logged when the session logs start, about a second after Go, with that time. Add new loggers inside this group.</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>TrialParameters</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>ResponseData</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>thisTrialData</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Zip" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>new(
    Item1.Item1.CorrectResponse as correctResponse,
    Item1.Item1.Response as response,
    Item1.Item1.TrialCnt as TrialCnt,
    Item1.Item2.trialType as trialType,
    Item1.Item2.RewardProbability as RewardProbability,
    Item1.Item2.IsRewarded as IsRewarded,
    Item1.Item2.IsRepeat as IsRepeat,
    Item1.Item2.RepeatCount as RepeatCount,
    Item1.Item2.targetSide as targetSide,
    Item1.Item2.ITI as ITI,
    Item1.Item2.Quiescent as Quiescent,
    Item1.Item2.rngSeedUsed as rngSeedUsed,
    Item1.Item2.autoRewardProbability as autoRewardProbability,
    Item1.Item2.autoReward as autoReward,
    Item1.Item2.largeReward as largeReward,
    Item1.Item2.RewardSizeInUl as RewardSizeInUl,
    Item1.Item2.BothSpouts as BothSpouts,
    Item1.Item2.visualAzimuth as visualAzimuth,
    Item1.Item2.visualContrast as visualContrast,
    Item1.Item2.visualPhase as visualPhase,
    Item1.Item2.audioAzimuth as audioAzimuth,
    Item1.Item2.OptogeneticEnabled as OptogeneticEnabled,
    Item1.Item2.OptogeneticCondition as OptogeneticCondition,
    Item1.Item2.OptogeneticDelay as OptogeneticDelay,
    Item1.Item2.OptogeneticDuration as OptogeneticDuration,
    Item1.Item2.OptogeneticPower as OptogeneticPower,
    Item1.Item2.IncorrectTimeoutDuration as IncorrectTimeoutDuration,
    Item1.Item2.LargeRewardMultiplier as LargeRewardMultiplier,
    Item1.Item2.LargeRewardProbability as LargeRewardProbability,
    Item1.Item2.BothSpoutsProbability as BothSpoutsProbability,
    Item1.Item2.openLoopDuration as openLoopDuration,
    Item1.Item2.closedLoopDuration as closedLoopDuration,
    Item1.Item2.visualElevation as visualElevation,
    Item1.Item2.visualGaussianWindowSigma as visualGaussianWindowSigma,
    Item1.Item2.visualOrientation as visualOrientation,
    Item1.Item2.visualSpatialFrequency as visualSpatialFrequency,
    Item1.Item2.visualTemporalFrequency as visualTemporalFrequency,
    Item1.Item2.visualFlickerFrequency as visualFlickerFrequency,
    Item1.Item2.audioElevation as audioElevation,
    Item1.Item2.audioFlickerFrequency as audioFlickerFrequency,
    Item1.Item2.audioWaveformIdx as audioWaveformIdx,
    Item2 as stimulusOnsetSeconds)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                          <Name>Timestamp</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogTrial.bonsai" />
                        <Expression xsi:type="WorkflowOutput" />
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StimulusOnset</Name>
                        </Expression>
