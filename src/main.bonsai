      <Expression xsi:type="GroupWorkflow">
        <Name>GUI Callbacks</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>ValveGUICallbacks</Name>
              <Description>ValveGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>GUI_Callback_Left_flush</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>1</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>GUI_Callback_Right_flush</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>2</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Merge" />
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>TriggerPulse</Name>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="4" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>StepperMotorGUICallbacks</Name>
              <Description>StepperMotorGUICallbacks</Description>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Annotation">
                    <Name>Update Motor IN position data</Name>
                    <Text><![CDATA[Update Motor IN position data]]></Text>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Position Update</Name>
                    <Description>Position Update</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Annotation">
                          <Name>Motor1_IN_position</Name>
                          <Text><![CDATA[Motor1_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor1_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor2_IN_position</Name>
                          <Text><![CDATA[Motor2_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor2_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor3_IN_position</Name>
                          <Text><![CDATA[Motor3_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor3_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor4_IN_position</Name>
                          <Text><![CDATA[Motor4_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor4_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Motor5_IN_position</Name>
                          <Text><![CDATA[Motor5_IN_position]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>Motor5_Position</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Grab all latest inputs</Name>
                          <Text><![CDATA[Grab all latest inputs]]></Text>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:CombineLatest" />
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Store IN position</Name>
                          <Text><![CDATA[Store IN position]]></Text>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StepperPosition_BothIn</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Sends command with every update</Name>
                          <Text><![CDATA[Sends command with every update]]></Text>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>Send command when session not running</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StartSession</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Send Command?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="BitwiseNot" />
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>StepperPositionCommand</Name>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>Don't send?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item2</Selector>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Sample" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="2" To="6" Label="Source1" />
                              <Edge From="2" To="9" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
