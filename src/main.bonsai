<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:p2="clr-namespace:UclOpenAvDome;assembly=Extensions"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:p3="clr-namespace:Harp.StepperDriver;assembly=Harp.StepperDriver"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:p4="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:p5="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:p6="clr-namespace:UclOpenAvDomeTask;assembly=Extensions"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:zg="clr-namespace:Bonsai.Gui.ZedGraph;assembly=Bonsai.Gui.ZedGraph"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DisplayDevice" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>RigSetup</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:ReadRigConfig">
                <p1:ConfigDirectory>C:\RigConfigs</p1:ConfigDirectory>
              </Combinator>
            </Expression>
            <Expression xsi:type="p2:DeserializeFromYaml">
              <p2:Type xsi:type="TypeMapping" TypeArguments="p2:UclOpenAvDomeRig" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="TimestampGenerator.PortName" />
                      <Property Name="TimerFrequency" Selector="TimestampGenerator.TimerFrequency" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TimestampGeneratorGen3.bonsai">
                    <CommandsSubjectName>TimestampGeneratorCommands</CommandsSubjectName>
                    <PortName>COMx</PortName>
                    <DumpRegisters>true</DumpRegisters>
                    <Heartbeat>Enabled</Heartbeat>
                    <EventsSubjectName>ClockSynchronizerEvents</EventsSubjectName>
                    <TimerFrequency>Timer1000Hz</TimerFrequency>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="BehaviorBoard.PortName" />
                      <Property Name="CountsPerRev" Selector="BehaviorBoard.RunningWheel.CountsPerRev" />
                      <Property Name="WheelDiameterMm" Selector="BehaviorBoard.RunningWheel.WheelDiameterMm" />
                      <Property Name="Trigger0Frequency" Selector="BehaviorBoard.CameraTriggerController.Trigger0Frequency" />
                      <Property Name="Trigger1Frequency" Selector="BehaviorBoard.CameraTriggerController.Trigger1Frequency" />
                      <Property Name="PulseDO1" Selector="BehaviorBoard.PulseController.PulseWidths.PulseDO1" />
                      <Property Name="PulseDO2" Selector="BehaviorBoard.PulseController.PulseWidths.PulseDO2" />
                      <Property Name="PulseDO3" Selector="BehaviorBoard.PulseController.PulseWidths.PulseDO3" />
                      <Property Name="OutputPulseEnable" Selector="BehaviorBoard.PulseController.OutputPulseEnable" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PortName" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <PortName>COMx</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="CountsPerRev" />
                          <Property Name="WheelDiameterMm" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.RunningWheel.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                          <CountsPerRev>4096</CountsPerRev>
                          <WheelDiameterMm>170</WheelDiameterMm>
                          <WheelDistanceSubjectName>WheelDistanceCm</WheelDistanceSubjectName>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PulseDO1" />
                          <Property Name="PulseDO2" />
                          <Property Name="PulseDO3" />
                          <Property Name="OutputPulseEnable" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>1</PulseDO1>
                          <PulseDO2>1</PulseDO2>
                          <PulseDO3>1</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerPulse</TriggerPulseSubjectName>
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Double)">
                          <rx:Name>DeliverRewardCommand</rx:Name>
                        </Expression>
                        <Expression xsi:type="rx:SelectMany">
                          <Name>DeliverReward</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="WorkflowInput">
                                <Name>Source1</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:AsyncSubject">
                                <Name>input</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>input</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item1</Selector>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Int determines which valve opens</Name>
                                <Text><![CDATA[Int determines which valve opens]]></Text>
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>TriggerPulse</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>RigConfigs</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>BehaviorBoard.PulseController.PulseWidths.PulseDO1,InterPulseInterval</Selector>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>LeftValve?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>input</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item1</Selector>
                                    </Expression>
                                    <Expression xsi:type="Equal">
                                      <Operand xsi:type="IntProperty">
                                        <Value>1</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>BehaviorBoard.PulseController.PulseWidths.PulseDO2,InterPulseInterval</Selector>
                              </Expression>
                              <Expression xsi:type="rx:Condition">
                                <Name>RightValve?</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>input</Name>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Item1</Selector>
                                    </Expression>
                                    <Expression xsi:type="Equal">
                                      <Operand xsi:type="IntProperty">
                                        <Value>2</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Expression>0.001 * (Item2.Item1 + Item2.Item2)</scr:Expression>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelayByInput.bonsai" />
                              <Expression xsi:type="SubscribeSubject">
                                <Name>input</Name>
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Item2</Selector>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Count" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:RepeatCount">
                                  <rx:Count>2</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="6" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                              <Edge From="6" To="13" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="7" To="10" Label="Source1" />
                              <Edge From="8" To="9" Label="Source1" />
                              <Edge From="9" To="12" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                              <Edge From="11" To="12" Label="Source2" />
                              <Edge From="12" To="13" Label="Source2" />
                              <Edge From="13" To="14" Label="Source1" />
                              <Edge From="14" To="15" Label="Source1" />
                              <Edge From="15" To="19" Label="Source1" />
                              <Edge From="16" To="17" Label="Source1" />
                              <Edge From="17" To="18" Label="Source1" />
                              <Edge From="18" To="19" Label="Source2" />
                              <Edge From="19" To="20" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="Trigger0Frequency" />
                          <Property Name="Trigger1Frequency" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.CameraTriggerController.bonsai">
                          <Trigger0Frequency>50</Trigger0Frequency>
                          <Trigger1Frequency>50</Trigger1Frequency>
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <Camera0TriggerEventsSubjectName>Camera0TriggerEvents</Camera0TriggerEventsSubjectName>
                          <Camera1TriggerEventsSubjectName>Camera1TriggerEvents</Camera1TriggerEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>true</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Delay">
                            <rx:DueTime>PT2S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>StartCameras</Name>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                        <Edge From="11" To="12" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplits</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="PortName" Selector="LicketySplitRight.PortName" />
                            <Property Name="Channel0TriggerThreshold" Selector="LicketySplitRight.Channel0TriggerThreshold" />
                            <Property Name="Channel0UntriggerThreshold" Selector="LicketySplitRight.Channel0UntriggerThreshold" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsRight</CommandsSubjectName>
                          <PortName>COMx</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsRight</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateRight</LickStateSubjectName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="PortName" Selector="LicketySplitLeft.PortName" />
                            <Property Name="Channel0TriggerThreshold" Selector="LicketySplitLeft.Channel0TriggerThreshold" />
                            <Property Name="Channel0UntriggerThreshold" Selector="LicketySplitLeft.Channel0UntriggerThreshold" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsLeft</CommandsSubjectName>
                          <PortName>COMx</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsLeft</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateLeft</LickStateSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Cameras</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>CameraFace</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="SerialNumber" Selector="SerialNumber" />
                            <Property Name="ExposureTime" Selector="ExposureTime" />
                            <Property Name="Gain" Selector="Gain" />
                            <Property Name="Binning" Selector="Binning" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>Camera0TriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents1</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>CameraBody</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="SerialNumber" Selector="SerialNumber" />
                            <Property Name="ExposureTime" Selector="ExposureTime" />
                            <Property Name="Gain" Selector="Gain" />
                            <Property Name="Binning" Selector="Binning" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>Camera0TriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents3</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>CameraPupil</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="SerialNumber" Selector="SerialNumber" />
                            <Property Name="ExposureTime" Selector="ExposureTime" />
                            <Property Name="Gain" Selector="Gain" />
                            <Property Name="Binning" Selector="Binning" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>Camera0TriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents2</FrameEventsSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="8" To="9" Label="Source1" />
                        <Edge From="9" To="10" Label="Source1" />
                        <Edge From="10" To="11" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>StepperDriver</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="StepperDriver1PortName" Selector="LickSpoutStage.DriverA.PortName" />
                            <Property Name="StepperDriver2PortName" Selector="LickSpoutStage.DriverB.PortName" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>InitializeStepperDrivers</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
                                <rx:Name>StepperDriver1Commands</rx:Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="PortName" DisplayName="StepperDriver1PortName" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p3:Device">
                                  <harp:OperationMode>Active</harp:OperationMode>
                                  <harp:OperationLed>On</harp:OperationLed>
                                  <harp:DumpRegisters>true</harp:DumpRegisters>
                                  <harp:VisualIndicators>On</harp:VisualIndicators>
                                  <harp:Heartbeat>Enabled</harp:Heartbeat>
                                  <harp:IgnoreErrors>false</harp:IgnoreErrors>
                                  <harp:PortName>COM7</harp:PortName>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperDriver1Events</Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
                                <rx:Name>StepperDriver2Commands</rx:Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="PortName" DisplayName="StepperDriver2PortName" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p3:Device">
                                  <harp:OperationMode>Active</harp:OperationMode>
                                  <harp:OperationLed>On</harp:OperationLed>
                                  <harp:DumpRegisters>true</harp:DumpRegisters>
                                  <harp:VisualIndicators>On</harp:VisualIndicators>
                                  <harp:Heartbeat>Enabled</harp:Heartbeat>
                                  <harp:IgnoreErrors>false</harp:IgnoreErrors>
                                  <harp:PortName>COM8</harp:PortName>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperDriver2Events</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="4" To="6" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                              <Edge From="6" To="7" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>Declarations</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_BothOut</rx:Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_BothIn</rx:Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_LeftIN</rx:Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_RightIN</rx:Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPositionCommand</rx:Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
