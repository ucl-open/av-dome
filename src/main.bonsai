      <Expression xsi:type="GroupWorkflow">
        <Name>InitialiseTrials</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Annotation">
              <Name>Read task configuration</Name>
              <Text><![CDATA[Load the task parameters from the committed task YAML, validated against the generated task schema. The loaded config is snapshotted to the session folder as TaskSchema.json.]]></Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="io:ReadAllText">
                <io:Path>..\config\task.yml</io:Path>
              </Combinator>
            </Expression>
            <Expression xsi:type="p6:DeserializeFromYaml">
              <p6:Type xsi:type="TypeMapping" TypeArguments="p6:UclOpenAvDomeTaskLogic" />
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="Annotation">
              <Name>Initialized first trial</Name>
              <Text><![CDATA[Initialized first trial]]></Text>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>TaskConfig</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:InitialiseTrial">
                <p1:trainingStageId>1</p1:trainingStageId>
                <p1:TrialType>-1</p1:TrialType>
                <p1:WasCorrect>true</p1:WasCorrect>
                <p1:WasTimeout>false</p1:WasTimeout>
                <p1:SeedOffset>0</p1:SeedOffset>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>thisTrialData</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>GUI</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Timer">
                <rx:DueTime>PT0S</rx:DueTime>
                <rx:Period>PT1S</rx:Period>
              </Combinator>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>TimeSpan.FromSeconds(it).ToString()</scr:Expression>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>sessionTime</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>StartSession</Name>
            </Expression>
            <Expression xsi:type="Combinator">
