            <Edge From="17" To="18" Label="Source1" />
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="1" To="4" Label="Source1" />
            <Edge From="3" To="4" Label="Source2" />
            <Edge From="4" To="6" Label="Source1" />
            <Edge From="5" To="6" Label="Source2" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="6" To="9" Label="Source1" />
            <Edge From="8" To="9" Label="Source2" />
            <Edge From="9" To="10" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="lv:StreamDevices">
        <Name>LiveView</Name>
        <Description>Streams every device in this machine's rig.yml that the workflow publishes, over ZeroMQ, for the live view (OpenRigs.LiveView): data on TCP 5556, video on 5558, from Start, in ready mode too. The three cameras as Camera-Face/Pupil/Body.video, 5 JPEG frames a second at 320 x 240, and the Behavior board's encoder from BehaviorBoard-Main.Data, 10 a second; each rate and size can be changed in rig.yml under the device's liveView:. Also elapsed, seconds since the experiment folder appeared, and liveview, this workflow and its commit. Every message carries the rig and the session key, ready until the experiment folder exists. Last in the workflow, because it streams only subjects built before it. A port already in use stops the workflow at Start.</Description>
        <lv:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</lv:ConfigRoot>
        <lv:DataPort>5556</lv:DataPort>
        <lv:VideoPort>5558</lv:VideoPort>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="0" To="1" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>