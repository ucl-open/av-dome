      </Expression>
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>ResponseData</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>StartSession</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Skip">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:SubscribeWhen" />
      </Expression>
      <Expression xsi:type="rx:TakeWhile">
        <Workflow>
          <Nodes>
            <Expression xsi:type="SubscribeSubject">
              <Name>StartSession</Name>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:TakeLast">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Repeat" />
      </Expression>
      <Expression xsi:type="lv:StreamDevices">
        <Name>LiveView</Name>
        <Description>Streams every device in this machine's rig.yml that the workflow publishes, over ZeroMQ, for the live view (OpenRigs.LiveView): data on TCP 5556, video on 5558, from Start, in ready mode too. The three cameras as Camera-Face/Pupil/Body.video, 5 JPEG frames a second at 320 x 240, and the Behavior board's encoder from BehaviorBoard-Main.Data, 10 a second; each rate and size can be changed in rig.yml under the device's liveView:. Also elapsed, seconds since the session folder appeared, and liveview, this workflow and its commit. Every message carries the rig and the session key, ready until the session folder exists. Last in the workflow, because it streams only subjects built before it. A port already in use stops the workflow at Start.</Description>
        <lv:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</lv:ConfigRoot>
        <lv:DataPort>5556</lv:DataPort>
        <lv:VideoPort>5558</lv:VideoPort>
      </Expression>
    </Nodes>
