<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:port="clr-namespace:Bonsai.IO.Ports;assembly=Bonsai.System"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:p2="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:p3="clr-namespace:System.Reactive;assembly=System.Reactive.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:p4="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:p5="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:p6="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="GroupWorkflow">
        <Name>MetaData</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:DeviceBehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <PortName>COMx</PortName>
                          <DumpRegisters>false</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:DeviceBehaviorBoard.CameraTriggerController.bonsai">
                          <TriggerFrequency>30</TriggerFrequency>
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:DeviceBehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>33</PulseDO1>
                          <PulseDO2>33</PulseDO2>
                          <PulseDO3>33</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerValve</TriggerPulseSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:DeviceBehaviorBoard.Timestamps.bonsai">
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:DeviceBehaviorBoard.RunningWheel.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                          <CountsPerRev>4096</CountsPerRev>
                          <WheelDiameterMm>170</WheelDiameterMm>
                          <WheelDistanceSubjectName>WheelDistanceCm</WheelDistanceSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplits</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="C:\dev\ucl-open\acquisition\src\UclOpen.Devices\LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsLeft</CommandsSubjectName>
                          <PortName>COM4</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsLeft</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateLeft</LickStateSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="C:\dev\ucl-open\acquisition\src\UclOpen.Devices\LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsRight</CommandsSubjectName>
                          <PortName>COM4</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsRight</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateRight</LickStateSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Cameras</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents1</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents2</FrameEventsSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="GroupWorkflow">
                      <Name>StepperMotors</Name>
                      <Workflow>
                        <Nodes>
                          <Expression xsi:type="Annotation">
                            <Name>StepperPosition_BothIn</Name>
                            <Text><![CDATA[StepperPosition_BothIn]]></Text>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>1000,1000,2000,2000,500;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="rx:BehaviorSubject">
                            <Name>StepperPosition_BothIn</Name>
                          </Expression>
                          <Expression xsi:type="Annotation">
                            <Name>StepperPosition_BothOut</Name>
                            <Text><![CDATA[StepperPosition_BothOut]]></Text>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>1000,1000,1000,1000,500;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="rx:BehaviorSubject">
                            <Name>StepperPosition_BothOut</Name>
                          </Expression>
                          <Expression xsi:type="ExternalizedMapping">
                            <Property Name="PortName" DisplayName="StepperPortName" />
                          </Expression>
                          <Expression xsi:type="Annotation">
                            <Name>What is this sequence doing?</Name>
                            <Text><![CDATA[]]></Text>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="port:SerialRead">
                              <port:PortName />
                              <port:Count>1</port:Count>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="p1:ConvertByteArrayToString" />
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:Repeat" />
                          </Expression>
                          <Expression xsi:type="Annotation">
                            <Name>InitHomePosition</Name>
                            <Text><![CDATA[InitHomePosition]]></Text>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Timer">
                              <gl:DueTime>PT0.5S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>0,0,0,0,0;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="rx:BehaviorSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="SubscribeSubject">
                            <Name>StepperPosition_BothIn</Name>
                          </Expression>
                          <Expression xsi:type="MulticastSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Timer">
                              <gl:DueTime>PT1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:SubscribeWhen" />
                          </Expression>
                          <Expression xsi:type="SubscribeSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_MoveTo</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="ExternalizedMapping">
                                  <Property Name="Name" />
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="PortName" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>71</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM10</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="5" Label="Source1" />
                                      <Edge From="1" To="3" Label="Source1" />
                                      <Edge From="2" To="3" Label="Source2" />
                                      <Edge From="3" To="4" Label="Source1" />
                                      <Edge From="4" To="5" Label="Source2" />
                                      <Edge From="5" To="6" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="2" Label="Source1" />
                                <Edge From="1" To="2" Label="Source2" />
                                <Edge From="2" To="3" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>300;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_AdjustSpeed</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="Name" />
                                      </Expression>
                                      <Expression xsi:type="SubscribeSubject">
                                        <Name>StepperPortName</Name>
                                      </Expression>
                                      <Expression xsi:type="PropertyMapping">
                                        <PropertyMappings>
                                          <Property Name="PortName" />
                                        </PropertyMappings>
                                      </Expression>
                                      <Expression xsi:type="Annotation">
                                        <Name>CommandByte_AdjustSpeed</Name>
                                        <Text><![CDATA[CommandByte_AdjustSpeed]]></Text>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>72</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM10</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="1" Label="Source1" />
                                      <Edge From="1" To="2" Label="Source1" />
                                      <Edge From="2" To="8" Label="Source1" />
                                      <Edge From="3" To="4" Label="Source1" />
                                      <Edge From="4" To="6" Label="Source1" />
                                      <Edge From="5" To="6" Label="Source2" />
                                      <Edge From="6" To="7" Label="Source1" />
                                      <Edge From="7" To="8" Label="Source2" />
                                      <Edge From="8" To="9" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="1" Label="Source1" />
                                <Edge From="1" To="2" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Delay">
                              <gl:DueTime>PT0.1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>20,2;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_AdjustAcceleration</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="Name" />
                                      </Expression>
                                      <Expression xsi:type="SubscribeSubject">
                                        <Name>StepperPortName</Name>
                                      </Expression>
                                      <Expression xsi:type="PropertyMapping">
                                        <PropertyMappings>
                                          <Property Name="PortName" />
                                        </PropertyMappings>
                                      </Expression>
                                      <Expression xsi:type="Annotation">
                                        <Name>CommandByte_AdjustAcceleration</Name>
                                        <Text><![CDATA[CommandByte_AdjustAcceleration]]></Text>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>73</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM6</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="1" Label="Source1" />
                                      <Edge From="1" To="2" Label="Source1" />
                                      <Edge From="2" To="8" Label="Source1" />
                                      <Edge From="3" To="4" Label="Source1" />
                                      <Edge From="4" To="6" Label="Source1" />
                                      <Edge From="5" To="6" Label="Source2" />
                                      <Edge From="6" To="7" Label="Source1" />
                                      <Edge From="7" To="8" Label="Source2" />
                                      <Edge From="8" To="9" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="1" Label="Source1" />
                                <Edge From="1" To="2" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Delay">
                              <gl:DueTime>PT0.1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:SubscribeWhen" />
                          </Expression>
                        </Nodes>
                        <Edges>
                          <Edge From="0" To="1" Label="Source1" />
                          <Edge From="1" To="2" Label="Source1" />
                          <Edge From="3" To="4" Label="Source1" />
                          <Edge From="4" To="5" Label="Source1" />
                          <Edge From="6" To="8" Label="Source1" />
                          <Edge From="7" To="8" Label="Source2" />
                          <Edge From="7" To="9" Label="Source2" />
                          <Edge From="7" To="10" Label="Source2" />
                          <Edge From="8" To="9" Label="Source1" />
                          <Edge From="9" To="10" Label="Source1" />
                          <Edge From="11" To="13" Label="Source1" />
                          <Edge From="12" To="13" Label="Source2" />
                          <Edge From="13" To="14" Label="Source1" />
                          <Edge From="15" To="16" Label="Source1" />
                          <Edge From="16" To="18" Label="Source1" />
                          <Edge From="17" To="18" Label="Source2" />
                          <Edge From="19" To="20" Label="Source1" />
                          <Edge From="20" To="27" Label="Source1" />
                          <Edge From="21" To="22" Label="Source1" />
                          <Edge From="22" To="23" Label="Source1" />
                          <Edge From="23" To="24" Label="Source1" />
                          <Edge From="24" To="25" Label="Source1" />
                          <Edge From="25" To="26" Label="Source1" />
                          <Edge From="26" To="27" Label="Source2" />
                        </Edges>
                      </Workflow>
                    </Builder>
                  </Expression>
                </Nodes>
                <Edges />
              </Workflow>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="GroupWorkflow">
                <Name>BonvisionResources</Name>
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="gl:CreateWindow">
                        <gl:Width>1920</gl:Width>
                        <gl:Height>1080</gl:Height>
                        <gl:VSync>On</gl:VSync>
                        <gl:SwapSync>false</gl:SwapSync>
                        <gl:ClearColor>Gray</gl:ClearColor>
                        <gl:ClearMask>DepthBufferBit ColorBufferBit</gl:ClearMask>
                        <gl:CursorVisible>false</gl:CursorVisible>
                        <gl:Location xsi:nil="true" />
                        <gl:WindowBorder>Fixed</gl:WindowBorder>
                        <gl:WindowState>Fullscreen</gl:WindowState>
                        <gl:DisplayDevice>Second</gl:DisplayDevice>
                        <gl:TargetRenderFrequency>60</gl:TargetRenderFrequency>
                        <gl:TargetUpdateFrequency xsi:nil="true" />
                        <gl:RenderState />
                        <gl:GraphicsMode>
                          <gl:ColorFormat>
                            <gl:Red>8</gl:Red>
                            <gl:Green>8</gl:Green>
                            <gl:Blue>8</gl:Blue>
                            <gl:Alpha>8</gl:Alpha>
                          </gl:ColorFormat>
                          <gl:Depth>16</gl:Depth>
                          <gl:Stencil>0</gl:Stencil>
                          <gl:Samples>0</gl:Samples>
                          <gl:AccumulatorFormat>
                            <gl:Red>0</gl:Red>
                            <gl:Green>0</gl:Green>
                            <gl:Blue>0</gl:Blue>
                            <gl:Alpha>0</gl:Alpha>
                          </gl:AccumulatorFormat>
                          <gl:Buffers>2</gl:Buffers>
                          <gl:Stereo>false</gl:Stereo>
                        </gl:GraphicsMode>
                      </Combinator>
                    </Expression>
                    <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.BonVisionResources.bonsai" />
                    <Expression xsi:type="Disable">
                      <Builder xsi:type="Combinator">
                        <Combinator xsi:type="gl:ShaderResources">
                          <gl:Shaders />
                        </Combinator>
                      </Builder>
                    </Expression>
                    <Expression xsi:type="Disable">
                      <Builder xsi:type="Combinator">
                        <Combinator xsi:type="gl:MeshResources">
                          <gl:Meshes />
                        </Combinator>
                      </Builder>
                    </Expression>
                    <Expression xsi:type="Disable">
                      <Builder xsi:type="Combinator">
