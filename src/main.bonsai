<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:port="clr-namespace:Bonsai.IO.Ports;assembly=Bonsai.System"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns:p2="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:p3="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:p4="clr-namespace:System.Reactive;assembly=System.Reactive.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:num="clr-namespace:Bonsai.Numerics;assembly=Bonsai.Numerics"
                 xmlns:p5="clr-namespace:Bonsai.Numerics.Distributions;assembly=Bonsai.Numerics"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:p6="clr-namespace:DataSchema;assembly=Extensions"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:p7="clr-namespace:AllenNeuralDynamics.LicketySplit;assembly=AllenNeuralDynamics.LicketySplit"
                 xmlns:ui="clr-namespace:Bonsai.Design;assembly=Bonsai.Design"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="GroupWorkflow">
        <Name>MetaData</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <PortName>COMx</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.RunningWheel.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                          <CountsPerRev>4096</CountsPerRev>
                          <WheelDiameterMm>170</WheelDiameterMm>
                          <WheelDistanceSubjectName>WheelDistanceCm</WheelDistanceSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>1</PulseDO1>
                          <PulseDO2>1</PulseDO2>
                          <PulseDO3>1</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerValve</TriggerPulseSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.CameraTriggerController.bonsai">
                          <TriggerFrequency>50</TriggerFrequency>
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.Timestamps.bonsai">
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplits</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsLeft</CommandsSubjectName>
                          <PortName>COM4</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsLeft</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateLeft</LickStateSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:LicketySplit.bonsai">
                          <CommandsSubjectName>LickCommandsRight</CommandsSubjectName>
                          <PortName>COM4</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Disabled</Heartbeat>
                          <EventsSubjectName>LickEventsRight</EventsSubjectName>
                          <Channel0TriggerThreshold>0</Channel0TriggerThreshold>
                          <Channel0UntriggerThreshold>0</Channel0UntriggerThreshold>
                          <LickStateSubjectName>LickStateRight</LickStateSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Cameras</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents1</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents2</FrameEventsSubjectName>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:TriggeredSpinnaker.bonsai">
                          <ExposureTime>19000</ExposureTime>
                          <Gain>0</Gain>
                          <Binning>1</Binning>
                          <SerialNumber xsi:nil="true" />
                          <ColorProcessing>Default</ColorProcessing>
                          <CameraTriggerEventsSubjectName>CameraTriggerEvents</CameraTriggerEventsSubjectName>
                          <FrameEventsSubjectName>FrameEvents3</FrameEventsSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges />
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="GroupWorkflow">
                      <Name>StepperMotors</Name>
                      <Workflow>
                        <Nodes>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>COM6</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="rx:BehaviorSubject">
                            <Name>StepperPortName</Name>
                          </Expression>
                          <Expression xsi:type="ExternalizedMapping">
                            <Property Name="Name" DisplayName="StepperPortName" />
                          </Expression>
                          <Expression xsi:type="SubscribeSubject">
                            <Name>StepperPortName</Name>
                          </Expression>
                          <Expression xsi:type="PropertyMapping">
                            <PropertyMappings>
                              <Property Name="PortName" />
                            </PropertyMappings>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="port:SerialRead">
                              <port:PortName>COM6</port:PortName>
                              <port:Count>1</port:Count>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="p1:ConvertByteArrayToString" />
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:Repeat" />
                          </Expression>
                          <Expression xsi:type="Annotation">
                            <Name>InitHomePosition</Name>
                            <Text><![CDATA[InitHomePosition]]></Text>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Timer">
                              <gl:DueTime>PT0.5S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>0,0,0,0,0;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="rx:BehaviorSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="SubscribeSubject">
                            <Name>StepperPosition_BothIn</Name>
                          </Expression>
                          <Expression xsi:type="MulticastSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Timer">
                              <gl:DueTime>PT1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:SubscribeWhen" />
                          </Expression>
                          <Expression xsi:type="SubscribeSubject">
                            <Name>StepperPositionCommand</Name>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_MoveTo</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="ExternalizedMapping">
                                  <Property Name="Name" />
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="Name" />
                                      </Expression>
                                      <Expression xsi:type="SubscribeSubject">
                                        <Name>StepperPortName</Name>
                                      </Expression>
                                      <Expression xsi:type="PropertyMapping">
                                        <PropertyMappings>
                                          <Property Name="PortName" />
                                        </PropertyMappings>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>71</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM10</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="1" Label="Source1" />
                                      <Edge From="1" To="2" Label="Source1" />
                                      <Edge From="2" To="7" Label="Source1" />
                                      <Edge From="3" To="5" Label="Source1" />
                                      <Edge From="4" To="5" Label="Source2" />
                                      <Edge From="5" To="6" Label="Source1" />
                                      <Edge From="6" To="7" Label="Source2" />
                                      <Edge From="7" To="8" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="2" Label="Source1" />
                                <Edge From="1" To="2" Label="Source2" />
                                <Edge From="2" To="3" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>300;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_AdjustSpeed</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="Name" />
                                      </Expression>
                                      <Expression xsi:type="SubscribeSubject">
                                        <Name>StepperPortName</Name>
                                      </Expression>
                                      <Expression xsi:type="PropertyMapping">
                                        <PropertyMappings>
                                          <Property Name="PortName" />
                                        </PropertyMappings>
                                      </Expression>
                                      <Expression xsi:type="Annotation">
                                        <Name>CommandByte_AdjustSpeed</Name>
                                        <Text><![CDATA[CommandByte_AdjustSpeed]]></Text>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>72</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM10</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="1" Label="Source1" />
                                      <Edge From="1" To="2" Label="Source1" />
                                      <Edge From="2" To="8" Label="Source1" />
                                      <Edge From="3" To="4" Label="Source1" />
                                      <Edge From="4" To="6" Label="Source1" />
                                      <Edge From="5" To="6" Label="Source2" />
                                      <Edge From="6" To="7" Label="Source1" />
                                      <Edge From="7" To="8" Label="Source2" />
                                      <Edge From="8" To="9" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="1" Label="Source1" />
                                <Edge From="1" To="2" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Delay">
                              <gl:DueTime>PT0.1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="StringProperty">
                              <Value>20,2;</Value>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="GroupWorkflow">
                            <Name>stepperCommand_AdjustAcceleration</Name>
                            <Workflow>
                              <Nodes>
                                <Expression xsi:type="WorkflowInput">
                                  <Name>Source1</Name>
                                </Expression>
                                <Expression xsi:type="rx:SelectMany">
                                  <Workflow>
                                    <Nodes>
                                      <Expression xsi:type="ExternalizedMapping">
                                        <Property Name="Name" />
                                      </Expression>
                                      <Expression xsi:type="SubscribeSubject">
                                        <Name>StepperPortName</Name>
                                      </Expression>
                                      <Expression xsi:type="PropertyMapping">
                                        <PropertyMappings>
                                          <Property Name="PortName" />
                                        </PropertyMappings>
                                      </Expression>
                                      <Expression xsi:type="Annotation">
                                        <Name>CommandByte_AdjustAcceleration</Name>
                                        <Text><![CDATA[CommandByte_AdjustAcceleration]]></Text>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="ByteProperty">
                                          <Value>73</Value>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowInput">
                                        <Name>Source1</Name>
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="rx:Zip" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="p1:CreateStepperMessage" />
                                      </Expression>
                                      <Expression xsi:type="Combinator">
                                        <Combinator xsi:type="port:SerialWrite">
                                          <port:PortName>COM6</port:PortName>
                                        </Combinator>
                                      </Expression>
                                      <Expression xsi:type="WorkflowOutput" />
                                    </Nodes>
                                    <Edges>
                                      <Edge From="0" To="1" Label="Source1" />
                                      <Edge From="1" To="2" Label="Source1" />
                                      <Edge From="2" To="8" Label="Source1" />
                                      <Edge From="3" To="4" Label="Source1" />
                                      <Edge From="4" To="6" Label="Source1" />
                                      <Edge From="5" To="6" Label="Source2" />
                                      <Edge From="6" To="7" Label="Source1" />
                                      <Edge From="7" To="8" Label="Source2" />
                                      <Edge From="8" To="9" Label="Source1" />
                                    </Edges>
                                  </Workflow>
                                </Expression>
                                <Expression xsi:type="WorkflowOutput" />
                              </Nodes>
                              <Edges>
                                <Edge From="0" To="1" Label="Source1" />
                                <Edge From="1" To="2" Label="Source1" />
                              </Edges>
                            </Workflow>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="gl:Delay">
                              <gl:DueTime>PT0.1S</gl:DueTime>
                            </Combinator>
                          </Expression>
                          <Expression xsi:type="Combinator">
                            <Combinator xsi:type="rx:SubscribeWhen" />
                          </Expression>
                        </Nodes>
                        <Edges>
                          <Edge From="0" To="1" Label="Source1" />
                          <Edge From="2" To="3" Label="Source1" />
                          <Edge From="3" To="4" Label="Source1" />
                          <Edge From="4" To="5" Label="Source1" />
                          <Edge From="5" To="6" Label="Source1" />
                          <Edge From="6" To="7" Label="Source1" />
                          <Edge From="8" To="10" Label="Source1" />
                          <Edge From="9" To="10" Label="Source2" />
                          <Edge From="10" To="11" Label="Source1" />
                          <Edge From="12" To="13" Label="Source1" />
                          <Edge From="13" To="15" Label="Source1" />
                          <Edge From="14" To="15" Label="Source2" />
                          <Edge From="16" To="17" Label="Source1" />
                          <Edge From="17" To="24" Label="Source1" />
                          <Edge From="18" To="19" Label="Source1" />
                          <Edge From="19" To="20" Label="Source1" />
                          <Edge From="20" To="21" Label="Source1" />
                          <Edge From="21" To="22" Label="Source1" />
                          <Edge From="22" To="23" Label="Source1" />
                          <Edge From="23" To="24" Label="Source2" />
                        </Edges>
                      </Workflow>
                    </Builder>
                  </Expression>
                </Nodes>
                <Edges />
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>BonvisionResources</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:CreateWindow">
                      <gl:Width>1920</gl:Width>
                      <gl:Height>1080</gl:Height>
                      <gl:VSync>On</gl:VSync>
                      <gl:SwapSync>false</gl:SwapSync>
                      <gl:ClearColor>Gray</gl:ClearColor>
                      <gl:ClearMask>DepthBufferBit ColorBufferBit</gl:ClearMask>
                      <gl:CursorVisible>false</gl:CursorVisible>
                      <gl:Location xsi:nil="true" />
                      <gl:WindowBorder>Fixed</gl:WindowBorder>
                      <gl:WindowState>Fullscreen</gl:WindowState>
                      <gl:DisplayDevice>Second</gl:DisplayDevice>
                      <gl:TargetRenderFrequency>60</gl:TargetRenderFrequency>
                      <gl:TargetUpdateFrequency xsi:nil="true" />
                      <gl:RenderState />
                      <gl:GraphicsMode>
                        <gl:ColorFormat>
                          <gl:Red>8</gl:Red>
                          <gl:Green>8</gl:Green>
                          <gl:Blue>8</gl:Blue>
                          <gl:Alpha>8</gl:Alpha>
                        </gl:ColorFormat>
                        <gl:Depth>16</gl:Depth>
                        <gl:Stencil>0</gl:Stencil>
                        <gl:Samples>0</gl:Samples>
                        <gl:AccumulatorFormat>
                          <gl:Red>0</gl:Red>
                          <gl:Green>0</gl:Green>
                          <gl:Blue>0</gl:Blue>
                          <gl:Alpha>0</gl:Alpha>
                        </gl:AccumulatorFormat>
                        <gl:Buffers>2</gl:Buffers>
                        <gl:Stereo>false</gl:Stereo>
                      </gl:GraphicsMode>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.BonVisionResources.bonsai" />
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="Combinator">
                      <Combinator xsi:type="gl:ShaderResources">
                        <gl:Shaders />
                      </Combinator>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="Combinator">
                      <Combinator xsi:type="gl:MeshResources">
                        <gl:Meshes />
                      </Combinator>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Disable">
                    <Builder xsi:type="Combinator">
                      <Combinator xsi:type="gl:TextureResources">
                        <gl:Textures />
                      </Combinator>
                    </Builder>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="res:LoadResources" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="gl:RenderFrame" />
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.OrthographicView.bonsai">
                    <Left>-135</Left>
                    <Right>135</Right>
                    <Bottom>-30</Bottom>
                    <Top>60</Top>
                  </Expression>
                  <Expression xsi:type="rx:PublishSubject">
                    <Name>DrawStimuli</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="BonVision:Environment.MeshMapping.bonsai">
                    <ClearColor>Gray</ClearColor>
                    <FileName>C:\dev\CoenLab\dev-sandbox\Workflows\Examples\MeshMapping\Test_MatlabOutput_azInterpVal5_elInterpVal_5_Gerion_fancy_interpolation.csv</FileName>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Audio</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>MixerDevice</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p2:CreateMixerContext">
                            <p2:HostApi>Windows WDM-KS</p2:HostApi>
                            <p2:DeviceName>Speakers (XMOS xCORE-200 MC (UAC2.0))</p2:DeviceName>
                            <p2:SampleRate>48000</p2:SampleRate>
                            <p2:SuggestedLatency>0.01</p2:SuggestedLatency>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p2:StartMixer" />
                        </Expression>
                        <Expression xsi:type="rx:BehaviorSubject">
                          <Name>Mixer</Name>
