                              <Expression xsi:type="SubscribeSubject">
                                <Name>Camera-Body.Data</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Skip">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="GroupWorkflow">
                                <Name>LogVideo</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="ExternalizedMapping">
                                      <Property Name="Name" />
                                    </Expression>
                                    <Expression xsi:type="GroupWorkflow">
                                      <Name>FormatFileName</Name>
                                      <Description>Generates a log filename based on the input timestamp.</Description>
                                      <Workflow>
                                        <Nodes>
                                          <Expression xsi:type="SubscribeSubject">
                                            <Name>PathPrefix</Name>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>Camera-Body</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="ExternalizedMapping">
                                            <Property Name="Value" DisplayName="Name" Description="The base name of the log file." />
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>Camera-Body</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="ExternalizedMapping">
                                            <Property Name="Value" DisplayName="Extension" Description="The file extension" />
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>csv</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Take">
                                              <rx:Count>1</rx:Count>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Zip" />
                                          </Expression>
                                          <Expression xsi:type="Format">
                                            <Format>{0}\{1}\{2}.{3}</Format>
                                            <Selector>Item1,Item2,Item3, Item4</Selector>
                                          </Expression>
                                          <Expression xsi:type="WorkflowOutput" />
                                        </Nodes>
                                        <Edges>
                                          <Edge From="0" To="7" Label="Source1" />
                                          <Edge From="1" To="7" Label="Source2" />
                                          <Edge From="2" To="3" Label="Source1" />
                                          <Edge From="3" To="7" Label="Source3" />
                                          <Edge From="4" To="5" Label="Source1" />
                                          <Edge From="5" To="6" Label="Source1" />
                                          <Edge From="6" To="7" Label="Source4" />
                                          <Edge From="7" To="8" Label="Source1" />
                                          <Edge From="8" To="9" Label="Source1" />
                                        </Edges>
                                      </Workflow>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="FileName" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="rx:Sink">
                                      <Name>CsvWriter</Name>
                                      <Workflow>
                                        <Nodes>
                                          <Expression xsi:type="WorkflowInput">
                                            <Name>Source1</Name>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>Seconds</Selector>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>Value.ChunkData.Timestamp</Selector>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>Value.ChunkData.FrameID</Selector>
                                          </Expression>
                                          <Expression xsi:type="MemberSelector">
                                            <Selector>Value.ChunkData.ExposureTime</Selector>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Zip" />
                                          </Expression>
                                          <Expression xsi:type="scr:ExpressionTransform">
                                            <scr:Expression>new(
Item1 as Seconds,
Item2 as Timestamp,
Item3 as FrameID,
Item4 as ExposureTime)</scr:Expression>
                                          </Expression>
                                          <Expression xsi:type="ExternalizedMapping">
                                            <Property Name="FileName" />
                                          </Expression>
                                          <Expression xsi:type="io:CsvWriter">
                                            <io:FileName />
                                            <io:Append>false</io:Append>
                                            <io:Overwrite>true</io:Overwrite>
                                            <io:Suffix>None</io:Suffix>
                                            <io:IncludeHeader>true</io:IncludeHeader>
                                            <io:Selector />
                                          </Expression>
                                          <Expression xsi:type="WorkflowOutput" />
                                        </Nodes>
                                        <Edges>
                                          <Edge From="0" To="1" Label="Source1" />
                                          <Edge From="0" To="2" Label="Source1" />
                                          <Edge From="0" To="3" Label="Source1" />
                                          <Edge From="0" To="4" Label="Source1" />
                                          <Edge From="1" To="5" Label="Source1" />
                                          <Edge From="2" To="5" Label="Source2" />
                                          <Edge From="3" To="5" Label="Source3" />
                                          <Edge From="4" To="5" Label="Source4" />
                                          <Edge From="5" To="6" Label="Source1" />
                                          <Edge From="6" To="8" Label="Source1" />
                                          <Edge From="7" To="8" Label="Source2" />
                                          <Edge From="8" To="9" Label="Source1" />
                                        </Edges>
                                      </Workflow>
                                    </Expression>
                                    <Expression xsi:type="MemberSelector">
                                      <Selector>Value.Image</Selector>
                                    </Expression>
                                    <Expression xsi:type="GroupWorkflow">
                                      <Name>FormatFileName</Name>
                                      <Description>Generates a log filename based on the input timestamp.</Description>
                                      <Workflow>
                                        <Nodes>
                                          <Expression xsi:type="SubscribeSubject">
                                            <Name>PathPrefix</Name>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>Camera-Body</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="ExternalizedMapping">
                                            <Property Name="Value" DisplayName="Name" Description="The base name of the log file." />
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>Camera-Body</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="ExternalizedMapping">
                                            <Property Name="Value" DisplayName="Extension" Description="The file extension" />
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="StringProperty">
                                              <Value>avi</Value>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Take">
                                              <rx:Count>1</rx:Count>
                                            </Combinator>
                                          </Expression>
                                          <Expression xsi:type="Combinator">
                                            <Combinator xsi:type="rx:Zip" />
                                          </Expression>
                                          <Expression xsi:type="Format">
                                            <Format>{0}\{1}\{2}.{3}</Format>
                                            <Selector>Item1,Item2,Item3, Item4</Selector>
                                          </Expression>
                                          <Expression xsi:type="WorkflowOutput" />
                                        </Nodes>
                                        <Edges>
                                          <Edge From="0" To="7" Label="Source1" />
                                          <Edge From="1" To="7" Label="Source2" />
                                          <Edge From="2" To="3" Label="Source1" />
                                          <Edge From="3" To="7" Label="Source3" />
                                          <Edge From="4" To="5" Label="Source1" />
                                          <Edge From="5" To="6" Label="Source1" />
                                          <Edge From="6" To="7" Label="Source4" />
                                          <Edge From="7" To="8" Label="Source1" />
                                          <Edge From="8" To="9" Label="Source1" />
                                        </Edges>
                                      </Workflow>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="FileName" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>BehaviorBoard-Main</Name>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="FrameRate" Selector="Settings.CameraTriggerController.Trigger0Frequency" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="cv:VideoWriter">
                                        <cv:FileName />
                                        <cv:Suffix>None</cv:Suffix>
                                        <cv:Buffered>true</cv:Buffered>
                                        <cv:Overwrite>true</cv:Overwrite>
                                        <cv:FourCC>FMP4</cv:FourCC>
                                        <cv:FrameRate>50</cv:FrameRate>
                                        <cv:FrameSize>
                                          <cv:Width>0</cv:Width>
                                          <cv:Height>0</cv:Height>
                                        </cv:FrameSize>
                                        <cv:ResizeInterpolation>NearestNeighbor</cv:ResizeInterpolation>
                                      </Combinator>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="4" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                    <Edge From="1" To="6" Label="Source1" />
                                    <Edge From="2" To="3" Label="Source1" />
                                    <Edge From="3" To="4" Label="Source2" />
                                    <Edge From="4" To="5" Label="Source1" />
                                    <Edge From="5" To="10" Label="Source1" />
                                    <Edge From="6" To="7" Label="Source1" />
                                    <Edge From="7" To="10" Label="Source2" />
                                    <Edge From="8" To="9" Label="Source1" />
                                    <Edge From="9" To="10" Label="Source3" />
                                    <Edge From="10" To="11" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>LicketySplit</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Left.Data</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                          <LogName>LicketySplit-Left</LogName>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>LicketySplit-Right.Data</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                          <LogName>LicketySplit-Right</LogName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TimestampGeneratorGen3-Main.Data</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>TimestampGeneratorGen3-Main</LogName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p2:SerializeToJson">
                      <p2:Formatting>Indented</p2:Formatting>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
                    <Name>RigSchema</Name>
                    <Extension>json</Extension>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TaskConfig</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p6:SerializeToJson">
                      <p6:Formatting>Indented</p6:Formatting>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
                    <Name>TaskSchema</Name>
                    <Extension>json</Extension>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>ZapitReplies</Name>
                    <Description>Harp-timestamped log of every Zapit reply: the presented condition and laser state per StartStimulus, plus the last startup query reply (GetNumConditions), handed over by the ZapitReplies BehaviorSubject when SessionLogs starts.</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>ZapitReplies</Name>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>new(
                CommandCode as command,
                Value as value,
                LaserOn as laserOn,
                IsError as isError,
                ServerDatenum as serverDatenum)</scr:Expression>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                          <Name>Timestamp</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
                          <LogName>Zapit</LogName>
                          <Selector />
                          <Extension>csv</Extension>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>StimulusTriggerLogs</Name>
                    <Description>Harp-timestamped CSV log of each stimulus onset (StimulusOnset: StartAuditoryStimulus stamped where it fires, so trial 1's onset, which comes before this log starts, keeps its own time).</Description>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>StimulusOnset</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
                          <LogName>StimulusStartEvents</LogName>
                          <Selector>Seconds,Value</Selector>
                          <Extension>csv</Extension>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>DecisionVariable</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                          <Name>Timestamp</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
                          <LogName>DecisionVariable</LogName>
                          <Selector>Seconds,Value</Selector>
                          <Extension>csv</Extension>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>visualAzimuth</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
                          <Name>Timestamp</Name>
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogData.bonsai">
                          <LogName>VisualAzimuth</LogName>
                          <Selector>Seconds,Value</Selector>
                          <Extension>csv</Extension>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="2" To="3" Label="Source1" />
                        <Edge From="3" To="4" Label="Source1" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="0" To="1" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StepperDriver1Events</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>LickSpoutStage-Main_DriverA</LogName>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>StepperDriver2Events</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="Extensions\LoggingPrefixCondition.bonsai" />
                  <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogHarpDevice.bonsai">
                    <LogName>LickSpoutStage-Main_DriverB</LogName>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="8" To="9" Label="Source1" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="17" Label="Source1" />
                  <Edge From="18" To="19" Label="Source1" />
                  <Edge From="19" To="20" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardLineLeft</Name>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Calibrated?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Calibrated</Selector>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ArtefactJson</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
              <Name>ValveCalibrationDO1</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardLineRight</Name>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>Calibrated?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Calibrated</Selector>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>ArtefactJson</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="OpenRigs.Logging:LogDataSchema.bonsai">
              <Name>ValveCalibrationDO2</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RewardDelivered</Name>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
              <Name>Timestamp</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>PathPrefix</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportMetric">
                <orcl:Name>path</orcl:Name>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orcl:ReportPhase">
                <orcl:Phase>Recording</orcl:Phase>
              </Combinator>
            </Expression>
            <Expression xsi:type="hd:RecordHarpDevices">
              <Name>RecordHarpDevices</Name>
              <Description>Checks every Harp device in rig.yml at Start and records it into each session (OpenRigs.HarpDevices): the Behavior board, the timestamp generator and both Lickety Splits (each a rig.yml entry with a portName whose data the workflow publishes as &lt;Name&gt;.Data) must be on their portName with their usbSerial, or the workflow stops saying which board is where; 0.5 s after the session folder appears it asks each for a register dump on &lt;Name&gt;.Commands, which its log records; and it writes &lt;Name&gt;\&lt;Name&gt;_device.json and the register map &lt;Name&gt;\&lt;Name&gt;.yml, which SessionManifest expects (harp). The lick spout stage's two driver boards are nested under one entry, so they are not checked here; their logs go into LickSpoutStage-Main.</Description>
              <hd:ConfigRoot>C:\Coen-Lab-Local\RigConfigs</hd:ConfigRoot>
            </Expression>
            <Expression xsi:type="mf:SessionManifest">
              <Name>SessionManifest</Name>
              <Description>Writes manifest.json into the session folder (OpenRigs.Manifest), finding PathPrefix itself: once when the folder appears and again when the workflow stops. No run is connected: a session ends with the controller's Stop, recorded as stopped with its reason. It records the machine, this repo's commit, Bonsai's command line, the settings at Go (SubjectId, SessionId and every parameter), rig.yml's path and hash, and what the session must leave: a folder for each device in rig.yml (BehaviorBoard-Main, TimestampGeneratorGen3-Main, LickSpoutStage-Main, LicketySplit-Left/Right, Camera-Face/Pupil/Body), the record and register map RecordHarpDevices writes for each Harp device (harp), RigSchema, TaskSchema, BonsaiData (BonsaiData_Trial and BonsaiData_Async) and StimulusStartEvents, which the overnight copy (rig-sync) alarms on if missing.</Description>
              <mf:IngestScript>av-dome</mf:IngestScript>
              <mf:ConfigFiles>C:\Coen-Lab-Local\RigConfigs\%COMPUTERNAME%\rig.yml</mf:ConfigFiles>
              <mf:ExpectedFiles>auto;harp;RigSchema/;TaskSchema/;BonsaiData/;StimulusStartEvents/</mf:ExpectedFiles>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>new(&quot;RewardDelivered&quot; as Event, (it.Line == 1 ? &quot;Left&quot; : it.Line == 2 ? &quot;Right&quot; : &quot;DO&quot; + it.Line.ToString()) + &quot; requested=&quot; + it.RequestedUl.ToString() + &quot; pulses=&quot; + it.Count.ToString() + &quot; calibrated=&quot; + it.Calibrated.ToString() + &quot; clamped=&quot; + it.Clamped.ToString() as Detail, it.DeliveredUl as Value)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orl:CreateAsyncEvent">
                <orl:Event>RewardDelivered</orl:Event>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>AsyncEvents</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ControlEvents</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>new((it.Kind.ToString() == &quot;Command&quot; ? it.Name : it.Kind.ToString()) as Event, it.ToString() as Detail)</scr:Expression>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="orl:CreateAsyncEvent">
                <orl:Event>Control</orl:Event>
              </Combinator>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Bonsai.Harp:WithLatestTimestamp.bonsai">
              <Name>Timestamp</Name>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>AsyncEvents</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="13" To="14" Label="Source1" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source1" />
            <Edge From="15" To="22" Label="Source1" />
            <Edge From="22" To="23" Label="Source1" />
            <Edge From="23" To="16" Label="Source1" />
            <Edge From="16" To="24" Label="Source1" />
            <Edge From="25" To="26" Label="Source1" />
            <Edge From="26" To="27" Label="Source1" />
            <Edge From="27" To="28" Label="Source1" />
            <Edge From="28" To="29" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ResponseData</Name>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>RedefineTrialData</Name>
        <Description>Each response ends a trial: draws the next one from the task configuration, the stage and the outcome (repeat rules), and publishes it as thisTrialData.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>source</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>source</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="SeedOffset" />
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>RedefineTrial</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TaskConfig</Name>
                  </Expression>
                  <Expression xsi:type="Annotation">
                    <Name>Without, WasCorrect doesn't get updated</Name>
                    <Text><![CDATA[Without, WasCorrect doesn't get updated]]></Text>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Delay">
                      <rx:DueTime>PT0.1S</rx:DueTime>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="SeedOffset" />
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TrainingStage</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="trainingStageId" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>CorrectResponse</Selector>
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="StringProperty">
                      <Value>Correct</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="StringProperty">
                      <Value>IncorrectAutoRewarded</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Zip" />
                  </Expression>
                  <Expression xsi:type="BitwiseOr" />
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="WasCorrect" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Equal">
                    <Operand xsi:type="StringProperty">
                      <Value>NoResponse</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="WasTimeout" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>TrialCount</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="TrialNumber" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:InitialiseTrial">
                      <p1:trainingStageId>4</p1:trainingStageId>
                      <p1:TrialType>-1</p1:TrialType>
                      <p1:WasCorrect>false</p1:WasCorrect>
                      <p1:WasTimeout>true</p1:WasTimeout>
                      <p1:SeedOffset>1</p1:SeedOffset>
                      <p1:TrialNumber>344</p1:TrialNumber>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                  <Expression xsi:type="MemberSelector">
                    <Selector>trialType</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>targetSide</Selector>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>visualContrast</Selector>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="2" Label="Source1" />
                  <Edge From="1" To="2" Label="Source2" />
                  <Edge From="2" To="17" Label="Source1" />
                  <Edge From="3" To="17" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="17" Label="Source3" />
                  <Edge From="6" To="7" Label="Source1" />
                  <Edge From="7" To="8" Label="Source1" />
                  <Edge From="7" To="9" Label="Source1" />
                  <Edge From="7" To="13" Label="Source1" />
                  <Edge From="8" To="10" Label="Source1" />
                  <Edge From="9" To="10" Label="Source2" />
                  <Edge From="10" To="11" Label="Source1" />
                  <Edge From="11" To="12" Label="Source1" />
                  <Edge From="12" To="17" Label="Source4" />
                  <Edge From="13" To="14" Label="Source1" />
                  <Edge From="14" To="17" Label="Source5" />
                  <Edge From="15" To="16" Label="Source1" />
                  <Edge From="16" To="17" Label="Source6" />
                  <Edge From="17" To="18" Label="Source1" />
                  <Edge From="17" To="19" Label="Source1" />
                  <Edge From="17" To="20" Label="Source1" />
                  <Edge From="17" To="21" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
            <Expression xsi:type="MemberSelector">
              <Selector>trialType</Selector>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="3" To="5" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="6" To="8" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>thisTrialData</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>thisTrialData</Name>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>SetTrialVars</Name>
        <Description>Resets the per-trial state for the new trial: the visual azimuth (start and current) and the decision variable.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>visualAzimuth</Selector>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>visualAzimuthStart</Name>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>visualAzimuth</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>DecisionVariable</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="1" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>thisTrialData</Name>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>ArmZapit</Name>
        <Description>Sends Zapit the stimulus command for an opto trial (condition, duration, delay, hardware-triggered or not); non-opto trials pass straight through.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>settings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>settings</Name>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>OptoTrial?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>OptogeneticEnabled</Selector>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>settings</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="ConditionNumber" Selector="OptogeneticCondition" />
                <Property Name="StimDuration" Selector="OptogeneticDuration" />
                <Property Name="StartDelay" Selector="OptogeneticDelay" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="HardwareTriggered" Selector="Zapit.HardwareTriggered" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:CreateStartStimulus">
                <p1:ConditionNumber>0</p1:ConditionNumber>
                <p1:LaserOn>true</p1:LaserOn>
                <p1:HardwareTriggered>true</p1:HardwareTriggered>
                <p1:Logging>true</p1:Logging>
                <p1:StimDuration>0</p1:StimDuration>
                <p1:LaserPower>0</p1:LaserPower>
                <p1:StartDelay>0</p1:StartDelay>
              </Combinator>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>ZapitCommands</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>false</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Name>NotOptoTrial?</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>OptogeneticEnabled</Selector>
                  </Expression>
                  <Expression xsi:type="BitwiseNot" />
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="BooleanProperty">
                <Value>false</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Sample" />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="15" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="3" To="12" Label="Source1" />
            <Edge From="4" To="9" Label="Source1" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="9" Label="Source2" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source3" />
            <Edge From="9" To="10" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="14" Label="Source1" />
            <Edge From="12" To="13" Label="Source1" />
            <Edge From="13" To="14" Label="Source2" />
            <Edge From="14" To="15" Label="Source3" />
            <Edge From="15" To="16" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelay.bonsai">
        <DueSeconds>0.1</DueSeconds>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>StartLaser</Name>
        <Description>Pulses the Zapit TTL line (zapit.triggerLine) 0.1 s after arming. The condition that limits this to hardware-triggered opto trials is disabled, so every trial pulses the line.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>settings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>settings</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="rx:Condition">
                <Name>HardwareTriggeredOptoTrial?</Name>
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="WorkflowInput">
                      <Name>Source1</Name>
                    </Expression>
                    <Expression xsi:type="MemberSelector">
                      <Selector>Item1</Selector>
                    </Expression>
                    <Expression xsi:type="MemberSelector">
                      <Selector>OptogeneticEnabled</Selector>
                    </Expression>
                    <Expression xsi:type="MemberSelector">
                      <Selector>Item2</Selector>
                    </Expression>
                    <Expression xsi:type="MemberSelector">
                      <Selector>Zapit.HardwareTriggered</Selector>
                    </Expression>
                    <Expression xsi:type="Combinator">
                      <Combinator xsi:type="rx:Zip" />
                    </Expression>
                    <Expression xsi:type="BitwiseAnd" />
                    <Expression xsi:type="WorkflowOutput" />
                  </Nodes>
                  <Edges>
                    <Edge From="0" To="1" Label="Source1" />
                    <Edge From="0" To="3" Label="Source1" />
                    <Edge From="1" To="2" Label="Source1" />
                    <Edge From="2" To="5" Label="Source1" />
                    <Edge From="3" To="4" Label="Source1" />
                    <Edge From="4" To="5" Label="Source2" />
                    <Edge From="5" To="6" Label="Source1" />
                    <Edge From="6" To="7" Label="Source1" />
                  </Edges>
                </Workflow>
              </Builder>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2.Zapit.TriggerLine</Selector>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>TriggerPulse</Name>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="PropertyMapping">
                <PropertyMappings>
                  <Property Name="ConditionNumber" Selector="OptogeneticCondition" />
                  <Property Name="StimDuration" Selector="OptogeneticDuration" />
                  <Property Name="StartDelay" Selector="OptogeneticDelay" />
                </PropertyMappings>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="PropertyMapping">
                <PropertyMappings>
                  <Property Name="HardwareTriggered" Selector="Zapit.HardwareTriggered" />
                </PropertyMappings>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="Combinator">
                <Combinator xsi:type="p1:CreateStartStimulus">
                  <p1:ConditionNumber>0</p1:ConditionNumber>
                  <p1:LaserOn>true</p1:LaserOn>
                  <p1:HardwareTriggered>true</p1:HardwareTriggered>
                  <p1:Logging>true</p1:Logging>
                  <p1:StimDuration>0</p1:StimDuration>
                  <p1:LaserPower>0</p1:LaserPower>
                  <p1:StartDelay>0</p1:StartDelay>
                </Combinator>
              </Builder>
            </Expression>
            <Expression xsi:type="Disable">
              <Builder xsi:type="MulticastSubject">
                <Name>ZapitCommands</Name>
              </Builder>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Sample" />
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="13" Label="Source1" />
            <Edge From="3" To="5" Label="Source1" />
            <Edge From="4" To="5" Label="Source2" />
            <Edge From="5" To="6" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="11" Label="Source1" />
            <Edge From="9" To="11" Label="Source2" />
            <Edge From="10" To="11" Label="Source3" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source2" />
            <Edge From="13" To="14" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelay.bonsai">
        <DueSeconds>0.5</DueSeconds>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>ExecuteTrial</Name>
        <Description>One trial: the quiescent wait, the stimulus (visual, auditory or both), the response window on the lick detectors, the consequences (reward, error sound, timeout) and the inter-trial interval; ends with the trial's response data.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>trial</Name>
            </Expression>
            <Expression xsi:type="rx:PublishSubject" TypeArguments="sys:String">
              <rx:Name>StopStimuli</rx:Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>trial</Name>
            </Expression>
            <Expression xsi:type="rx:SelectMany">
              <Name>StimuliPresentation</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="rx:Take">
                      <rx:Count>1</rx:Count>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="Annotation">
                    <Name>Auditory Stimulus</Name>
                    <Text><![CDATA[Auditory Stimulus]]></Text>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>Define Speaker location</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>thisTrialData</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>audioAzimuth</Selector>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="X" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="gl:CreateVector3">
                            <gl:X>0</gl:X>
                            <gl:Y>15</gl:Y>
                            <gl:Z>0</gl:Z>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>SpeakerLocations</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="Locations" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p1:SpatialLookup">
                            <p1:Locations>
                              <p1:Vector3>
                                <p1:X>-90</p1:X>
                                <p1:Y>15</p1:Y>
                                <p1:Z>0</p1:Z>
                              </p1:Vector3>
                              <p1:Vector3>
                                <p1:X>90</p1:X>
                                <p1:Y>15</p1:Y>
                                <p1:Z>0</p1:Z>
                              </p1:Vector3>
                              <p1:Vector3>
                                <p1:X>0</p1:X>
                                <p1:Y>15</p1:Y>
                                <p1:Z>0</p1:Z>
                              </p1:Vector3>
                            </p1:Locations>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="MulticastSubject">
                          <Name>ActiveSoundChannels</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Sample" />
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                        <Edge From="2" To="3" Label="Source2" />
                        <Edge From="3" To="6" Label="Source1" />
                        <Edge From="4" To="5" Label="Source1" />
                        <Edge From="5" To="6" Label="Source2" />
                        <Edge From="6" To="7" Label="Source1" />
                        <Edge From="7" To="9" Label="Source1" />
                        <Edge From="8" To="9" Label="Source2" />
                        <Edge From="9" To="10" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="BooleanProperty">
                      <Value>true</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="MulticastSubject">
                    <Name>StartAuditoryStimulus</Name>
                  </Expression>
                  <Expression xsi:type="Annotation">
                    <Name>Visual Stimulus</Name>
                    <Text><![CDATA[Visual Stimulus]]></Text>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>settings</Name>
                  </Expression>
                  <Expression xsi:type="rx:SelectMany">
                    <Name>FlashingVisualStimulus</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="WorkflowInput">
                          <Name>Source1</Name>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Take">
                            <rx:Count>1</rx:Count>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:AsyncSubject">
                          <Name>trialSettings</Name>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>DrawStimuli</Name>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>16Hz</Name>
                          <Text><![CDATA[16Hz]]></Text>
                        </Expression>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>trialSettings</Name>
                        </Expression>
                        <Expression xsi:type="MemberSelector">
                          <Selector>visualFlickerFrequency</Selector>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Double freq for On/Off</Name>
                          <Text><![CDATA[Double freq for On/Off]]></Text>
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
