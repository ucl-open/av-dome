                          <PropertyMappings>
                            <Property Name="ExtentX" Selector="it" />
                            <Property Name="ExtentY" Selector="it" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="Annotation">
                            <Name>GaussianWindowSigma in deg</Name>
                            <Text><![CDATA[GaussianWindowSigma in deg]]></Text>
                          </Builder>
                        </Expression>
                        <Expression xsi:type="Disable">
                          <Builder xsi:type="Combinator">
                            <Combinator xsi:type="FloatProperty">
                              <Value>9</Value>
                            </Combinator>
                          </Builder>
                        </Expression>
