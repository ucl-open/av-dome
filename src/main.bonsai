<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:p2="clr-namespace:Harp.TimestampGeneratorGen3;assembly=Harp.TimestampGeneratorGen3"
                 xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:p3="clr-namespace:AllenNeuralDynamics.LicketySplit;assembly=AllenNeuralDynamics.LicketySplit"
                 xmlns:p4="clr-namespace:UclOpen.Video;assembly=UclOpen.Video"
                 xmlns:spk="clr-namespace:Bonsai.Spinnaker;assembly=Bonsai.Spinnaker"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:p5="clr-namespace:Harp.StepperDriver;assembly=Harp.StepperDriver"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:res="clr-namespace:Bonsai.Resources;assembly=Bonsai.System"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:p6="clr-namespace:Bonsai.Mixer;assembly=Bonsai.Mixer"
                 xmlns:p7="clr-namespace:OpenCV.Net;assembly=OpenCV.Net"
                 xmlns:p8="clr-namespace:DataSchema;assembly=Extensions"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision"
                 xmlns:zg="clr-namespace:Bonsai.Gui.ZedGraph;assembly=Bonsai.Gui.ZedGraph"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:p9="clr-namespace:UclOpen.Core;assembly=UclOpen.Core"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="DisplayDevice" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>MetaData</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="StringProperty">
                <Value>GreenDome2</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:RigConfigs">
                <p1:MachineName>GREEN-DOME-2</p1:MachineName>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>RigConfigs</Name>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Declarations</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Single)">
                    <rx:Name>PerformanceTracking</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
                    <rx:Name>TrialSuccess</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
                    <rx:Name>SessionPaused</rx:Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>TrialCount</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="DoubleProperty">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>WaterDelivered</Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
                    <rx:Name>SteppersZEROed</rx:Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="COMPortTimestampGenerator" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>TimestampGenerator</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="BooleanProperty">
                            <Value>false</Value>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="harp:SynchronizeTimestamp" />
                        </Expression>
                        <Expression xsi:type="p2:CreateMessage">
                          <harp:MessageType>Write</harp:MessageType>
                          <harp:Payload xsi:type="p2:CreateTimerFrequencyPayload">
                            <p2:TimerFrequency>Timer1000Hz</p2:TimerFrequency>
                          </harp:Payload>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PortName" />
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="p2:Device">
                            <harp:OperationMode>Active</harp:OperationMode>
                            <harp:OperationLed>On</harp:OperationLed>
                            <harp:DumpRegisters>true</harp:DumpRegisters>
                            <harp:VisualIndicators>On</harp:VisualIndicators>
                            <harp:Heartbeat>Enabled</harp:Heartbeat>
                            <harp:IgnoreErrors>false</harp:IgnoreErrors>
                            <harp:PortName>COM9</harp:PortName>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="rx:PublishSubject">
                          <Name>ClockSynchronizerEvents</Name>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                        <Expression xsi:type="GroupWorkflow">
                          <Name>Timestamps</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>ClockSynchronizerEvents</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="harp:FilterMessageType">
                                  <harp:FilterType>Include</harp:FilterType>
                                  <harp:MessageType>Event</harp:MessageType>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="harp:FilterRegister">
                                <harp:FilterType>Include</harp:FilterType>
                                <harp:Register xsi:type="harp:TimestampSeconds" />
                              </Expression>
                              <Expression xsi:type="rx:PublishSubject">
                                <Name>Heartbeats</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>ClockSynchronizerEvents</Name>
                              </Expression>
                              <Expression xsi:type="p2:Parse">
                                <harp:Register xsi:type="p2:Timer" />
                              </Expression>
                              <Expression xsi:type="InputMapping">
                                <PropertyMappings>
                                  <Property Name="Value" Selector="it" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="DoubleProperty">
                                  <Value>1311005269</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Timestamp</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Timestamp</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:WithLatestFrom" />
                              </Expression>
                              <Expression xsi:type="Subtract" />
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Timebase</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="8" To="11" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source2" />
                              <Edge From="11" To="12" Label="Source1" />
                              <Edge From="12" To="13" Label="Source1" />
                              <Edge From="13" To="14" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="3" Label="Source1" />
                        <Edge From="2" To="3" Label="Source2" />
                        <Edge From="3" To="5" Label="Source1" />
                        <Edge From="4" To="5" Label="Source2" />
                        <Edge From="5" To="6" Label="Source1" />
                        <Edge From="6" To="7" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="COMPortBehaviourBoard" />
                      <Property Name="PulseDO1" Selector="ValveOpenTimeLeft" />
                      <Property Name="PulseDO2" Selector="ValveOpenTimeRight" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PortName" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <PortName>COM10</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>RunningWheel</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateEnableEncodersPayload">
                                  <beh:EnableEncoders>EncoderPort2</beh:EnableEncoders>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateEncoderModePayload">
                                  <beh:EncoderMode>Position</beh:EncoderMode>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateEncoderResetPayload">
                                  <beh:EncoderReset>EncoderPort2</beh:EncoderReset>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="CommandsSubjectName" Description="The name of the Subject that carries command messages for a specific behavior device" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>BehaviorCommands</Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="EventsSubjectName" Description="The name of the Subject that carries event messages from a specific behavior device" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorEvents</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:SubscribeWhen" />
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorEvents</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:DelaySubscription">
                                  <rx:DueTime>PT0.1S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="beh:Parse">
                                <harp:Register xsi:type="beh:AnalogData" />
                              </Expression>
                              <Expression xsi:type="MemberSelector">
                                <Selector>Encoder</Selector>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="dsp:Difference">
                                  <dsp:Order>1</dsp:Order>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="scr:ExpressionTransform">
                                <scr:Name>ConvertSigned</scr:Name>
                                <scr:Expression>it &gt; 32768.0 ? it - 65536.0 : (it &lt; -32768.0 ? it + 65536.0 : it)</scr:Expression>
                              </Expression>
                              <Expression xsi:type="rx:Accumulate" />
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="CountsPerRev" />
                                <Property Name="WheelDiameterMm" />
                              </Expression>
                              <Expression xsi:type="GroupWorkflow">
                                <Name>TicksToCentimeters</Name>
                                <Description>Converts steps on a quadrature encoder to a distance in cm, published to a Subject</Description>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="ExternalizedMapping">
                                      <Property Name="Value" DisplayName="CountsPerRev" Description="The number of steps recorded on the quadrature encoder in a full revolution" Category="Running Wheel" />
                                    </Expression>
                                    <Expression xsi:type="Divide">
                                      <Operand xsi:type="WorkflowProperty" TypeArguments="sys:Int16">
                                        <Value>4096</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="ExternalizedMapping">
                                      <Property Name="Value" DisplayName="WheelDiameterMm" Description="The diameter of the wheel, in millimetres" Category="Running Wheel" />
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="IntProperty">
                                        <Value>170</Value>
                                      </Combinator>
                                    </Expression>
                                    <Expression xsi:type="scr:ExpressionTransform">
                                      <scr:Name>CircumferenceCm</scr:Name>
                                      <scr:Expression>(it*Math.Pi)/10</scr:Expression>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="Value" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="Multiply">
                                      <Operand xsi:type="FloatProperty">
                                        <Value>53.407074</Value>
                                      </Operand>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="2" Label="Source2" />
                                    <Edge From="1" To="2" Label="Source3" />
                                    <Edge From="2" To="7" Label="Source1" />
                                    <Edge From="3" To="4" Label="Source1" />
                                    <Edge From="4" To="5" Label="Source1" />
                                    <Edge From="5" To="6" Label="Source1" />
                                    <Edge From="6" To="7" Label="Source2" />
                                    <Edge From="7" To="8" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="WheelDistanceSubjectName" Description="The name of the Subject that carries the wheel distance in cm" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="rx:PublishSubject">
                                <Name>WheelDistanceCm</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="3" Label="Source1" />
                              <Edge From="1" To="3" Label="Source2" />
                              <Edge From="2" To="3" Label="Source3" />
                              <Edge From="3" To="5" Label="Source1" />
                              <Edge From="4" To="5" Label="Source2" />
                              <Edge From="5" To="8" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="6" To="9" Label="Source1" />
                              <Edge From="7" To="8" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                              <Edge From="11" To="12" Label="Source1" />
                              <Edge From="12" To="13" Label="Source1" />
                              <Edge From="13" To="14" Label="Source1" />
                              <Edge From="14" To="15" Label="Source1" />
                              <Edge From="15" To="17" Label="Source1" />
                              <Edge From="16" To="17" Label="Source2" />
                              <Edge From="17" To="19" Label="Source1" />
                              <Edge From="18" To="19" Label="Source2" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PulseDO1" />
                          <Property Name="PulseDO2" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>40</PulseDO1>
                          <PulseDO2>40</PulseDO2>
                          <PulseDO3>20</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerValve</TriggerPulseSubjectName>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>CameraTriggerController</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Object">
                                <rx:Name>StartCameras</rx:Name>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateStartCamerasPayload">
                                  <beh:StartCameras>CameraOutput0</beh:StartCameras>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Object">
                                <rx:Name>StopCameras</rx:Name>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateStopCamerasPayload">
                                  <beh:StopCameras>CameraOutput0</beh:StopCameras>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Value" DisplayName="Trigger0Frequency" Description="The frequency, in Hz, at which to trigger cameras on Trigger0" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="DoubleProperty">
                                  <Value>50</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Trigger0Frequency</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Camera0Frequency" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateCamera0FrequencyPayload">
                                  <beh:Camera0Frequency>50</beh:Camera0Frequency>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Value" DisplayName="Trigger1Frequency" Description="The frequency, in Hz, at which to trigger cameras on Trigger1" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="DoubleProperty">
                                  <Value>50</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Trigger1Frequency</Name>
                              </Expression>
                              <Expression xsi:type="PropertyMapping">
                                <PropertyMappings>
                                  <Property Name="Camera1Frequency" />
                                </PropertyMappings>
                              </Expression>
                              <Expression xsi:type="beh:CreateMessage">
                                <harp:MessageType>Write</harp:MessageType>
                                <harp:Payload xsi:type="beh:CreateCamera1FrequencyPayload">
                                  <beh:Camera1Frequency>50</beh:Camera1Frequency>
                                </harp:Payload>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Concat" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Merge" />
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="BehaviorCommandsSubjectName" Description="The name of the commands subject for the behavior board that triggers camera frames" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="MulticastSubject">
                                <Name>BehaviorCommands</Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="BehaviorEventsSubjectName" Description="The name of the subject carrying events from the behavior board that triggers camera frames" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorEvents</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Delay">
                                  <rx:DueTime>PT0.5S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:SubscribeWhen" />
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorEvents</Name>
                              </Expression>
                              <Expression xsi:type="beh:Parse">
                                <harp:Register xsi:type="beh:TimestampedCamera0Frame" />
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="Camera0TriggerEventsSubjectName" Description="The name of the subject to which timestamped camera trigger events Trigger0 are published" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="rx:PublishSubject">
                                <Name>Camera0TriggerEvents</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>BehaviorEvents</Name>
                              </Expression>
                              <Expression xsi:type="beh:Parse">
                                <harp:Register xsi:type="beh:TimestampedCamera1Frame" />
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="Name" DisplayName="Camera1TriggerEventsSubjectName" Description="The name of the subject to which timestamped camera trigger events Trigger1 are published" Category="Subjects" />
                              </Expression>
                              <Expression xsi:type="rx:PublishSubject">
                                <Name>Camera1TriggerEvents</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="17" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="3" To="17" Label="Source2" />
                              <Edge From="4" To="5" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="6" To="7" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
