                    <FrameRate>50</FrameRate>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>Camera2FrameForGUI</Name>
                  </Expression>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>FrameEvents3</Name>
                  </Expression>
                  <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Logging:LogVideo.bonsai">
