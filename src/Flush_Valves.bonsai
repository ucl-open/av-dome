<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:p2="clr-namespace:Harp.StepperDriver;assembly=Harp.StepperDriver"
                 xmlns:gui="clr-namespace:Bonsai.Gui;assembly=Bonsai.Gui"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="StringProperty">
          <Value>GreenDome2</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RigConfigs">
          <p1:MachineName>BLUE-OPTO-2</p1:MachineName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Take">
          <rx:Count>1</rx:Count>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:AsyncSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>MetaData</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="GroupWorkflow">
              <Name>Declarations</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Single)">
                    <rx:Name>PerformanceTracking</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:String">
                    <rx:Name>TrialSuccess</rx:Name>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Boolean">
                    <rx:Name>SessionPaused</rx:Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="IntProperty">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>TrialCount</Name>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="DoubleProperty">
                      <Value>0</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:BehaviorSubject">
                    <Name>WaterDelivered</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="3" To="4" Label="Source1" />
                  <Edge From="5" To="6" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>HardwareDevices</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="SubscribeSubject">
                    <Name>RigConfigs</Name>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PortName" Selector="COMPortBehaviourBoard" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="FloatProperty">
                      <Value>100000</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PulseDO1" Selector="it" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="FloatProperty">
                      <Value>100000</Value>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="PropertyMapping">
                    <PropertyMappings>
                      <Property Name="PulseDO2" Selector="it" />
                    </PropertyMappings>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>BehaviorBoards</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PortName" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.BehaviorBoard.bonsai">
                          <CommandsSubjectName>BehaviorCommands</CommandsSubjectName>
                          <PortName>COM11</PortName>
                          <DumpRegisters>true</DumpRegisters>
                          <Heartbeat>Enabled</Heartbeat>
                          <EventsSubjectName>BehaviorEvents</EventsSubjectName>
                        </Expression>
                        <Expression xsi:type="ExternalizedMapping">
                          <Property Name="PulseDO1" />
                          <Property Name="PulseDO2" />
                        </Expression>
                        <Expression xsi:type="IncludeWorkflow" Path="UclOpen.Devices:BehaviorBoard.PulseController.bonsai">
                          <BehaviorCommandsSubjectName>BehaviorCommands</BehaviorCommandsSubjectName>
                          <OutputPulseEnable>DO1 DO2 DO3</OutputPulseEnable>
                          <PulseDO1>34464</PulseDO1>
                          <PulseDO2>34464</PulseDO2>
                          <PulseDO3>20</PulseDO3>
                          <BehaviorEventsSubjectName>BehaviorEvents</BehaviorEventsSubjectName>
                          <TriggerPulseSubjectName>TriggerValve</TriggerPulseSubjectName>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="2" To="3" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>StepperDriver</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="SubscribeSubject">
                          <Name>RigConfigs</Name>
                        </Expression>
                        <Expression xsi:type="PropertyMapping">
                          <PropertyMappings>
                            <Property Name="StepperDriver1PortName" Selector="COMPortStepperDriver1" />
                            <Property Name="StepperDriver2PortName" Selector="COMPortStepperDriver2" />
                          </PropertyMappings>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>InitializeStepperDrivers</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
                                <rx:Name>StepperDriver1Commands</rx:Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="PortName" DisplayName="StepperDriver1PortName" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p2:Device">
                                  <harp:OperationMode>Active</harp:OperationMode>
                                  <harp:OperationLed>On</harp:OperationLed>
                                  <harp:DumpRegisters>true</harp:DumpRegisters>
                                  <harp:VisualIndicators>On</harp:VisualIndicators>
                                  <harp:Heartbeat>Enabled</harp:Heartbeat>
                                  <harp:IgnoreErrors>false</harp:IgnoreErrors>
                                  <harp:PortName>COM14</harp:PortName>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperDriver1Events</Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
                                <rx:Name>StepperDriver2Commands</rx:Name>
                              </Expression>
                              <Expression xsi:type="ExternalizedMapping">
                                <Property Name="PortName" DisplayName="StepperDriver2PortName" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p2:Device">
                                  <harp:OperationMode>Active</harp:OperationMode>
                                  <harp:OperationLed>On</harp:OperationLed>
                                  <harp:DumpRegisters>true</harp:DumpRegisters>
                                  <harp:VisualIndicators>On</harp:VisualIndicators>
                                  <harp:Heartbeat>Enabled</harp:Heartbeat>
                                  <harp:IgnoreErrors>false</harp:IgnoreErrors>
                                  <harp:PortName>COM12</harp:PortName>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperDriver2Events</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="2" Label="Source1" />
                              <Edge From="1" To="2" Label="Source2" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="4" To="6" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                              <Edge From="6" To="7" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>Declarations</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_BothOut</rx:Name>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="sys:Tuple(sys:Int32,sys:Int32,sys:Int32,sys:Int32,sys:Int32)">
                                <rx:Name>StepperPosition_BothIn</rx:Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperPosition_HOME</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Delay">
                                  <rx:DueTime>PT3S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Annotation">
                                <Name>Init by Moving to ZERO</Name>
                                <Text><![CDATA[Init by Moving to ZERO]]></Text>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>StepperPositionCommand</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="2" To="7" Label="Source1" />
                              <Edge From="3" To="7" Label="Source2" />
                              <Edge From="4" To="7" Label="Source3" />
                              <Edge From="5" To="7" Label="Source4" />
                              <Edge From="6" To="7" Label="Source5" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="7" To="9" Label="Source1" />
                              <Edge From="9" To="11" Label="Source1" />
                              <Edge From="10" To="11" Label="Source2" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>ReadSwitchStates</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperDriver1Events</Name>
                              </Expression>
                              <Expression xsi:type="p2:Parse">
                                <harp:Register xsi:type="p2:DigitalInputState" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p1:UnpackSwitchTriggers" />
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor0_switchState</Name>
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>1</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor1_switchState</Name>
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>2</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor2_switchState</Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperDriver2Events</Name>
                              </Expression>
                              <Expression xsi:type="p2:Parse">
                                <harp:Register xsi:type="p2:DigitalInputState" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p1:UnpackSwitchTriggers" />
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>0</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor3_switchState</Name>
                              </Expression>
                              <Expression xsi:type="Index">
                                <Operand xsi:type="IntProperty">
                                  <Value>1</Value>
                                </Operand>
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>_Motor4_switchState</Name>
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="2" To="5" Label="Source1" />
                              <Edge From="2" To="7" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                              <Edge From="5" To="6" Label="Source1" />
                              <Edge From="7" To="8" Label="Source1" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                              <Edge From="11" To="12" Label="Source1" />
                              <Edge From="11" To="14" Label="Source1" />
                              <Edge From="12" To="13" Label="Source1" />
                              <Edge From="14" To="15" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>InitialiseStepperDriverSettings</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperDriver1Events</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Take">
                                  <rx:Count>20</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:TakeLast">
                                  <rx:Count>1</rx:Count>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Delay">
                                  <rx:DueTime>PT0.1S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Unit" />
                              <Expression xsi:type="rx:Defer">
                                <Name>Initialize StepperDriver1</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="WorkflowInput">
                                      <Name>Source1</Name>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateInterlockEnabledPayload">
                                        <p2:InterlockEnabled>Open</p2:InterlockEnabled>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateEnableDriverPayload">
                                        <p2:EnableDriver>Motor0 Motor1 Motor2</p2:EnableDriver>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor0MaximumRunCurrentPayload">
                                        <p2:Motor0MaximumRunCurrent>0.5</p2:Motor0MaximumRunCurrent>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor1MaximumRunCurrentPayload">
                                        <p2:Motor1MaximumRunCurrent>0.5</p2:Motor1MaximumRunCurrent>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor2MaximumRunCurrentPayload">
                                        <p2:Motor2MaximumRunCurrent>0.5</p2:Motor2MaximumRunCurrent>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor0MicrostepResolutionPayload">
                                        <p2:Motor0MicrostepResolution>Microstep8</p2:Motor0MicrostepResolution>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor1MicrostepResolutionPayload">
                                        <p2:Motor1MicrostepResolution>Microstep8</p2:Motor1MicrostepResolution>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor2MicrostepResolutionPayload">
                                        <p2:Motor2MicrostepResolution>Microstep8</p2:Motor2MicrostepResolution>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateEnableEncodersPayload">
                                        <p2:EnableEncoders>Encoder0 Encoder1 Encoder2</p2:EnableEncoders>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateResetEncodersPayload">
                                        <p2:ResetEncoders>Encoder0 Encoder1 Encoder2</p2:ResetEncoders>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateEncoderModePayload">
                                        <p2:EncoderMode>Position</p2:EncoderMode>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateEncoderSamplingRatePayload">
                                        <p2:EncoderSamplingRate>Rate500Hz</p2:EncoderSamplingRate>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateAccumulatedStepsSamplingRatePayload">
                                        <p2:AccumulatedStepsSamplingRate>Rate100Hz</p2:AccumulatedStepsSamplingRate>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateEnableDigitalInputsPayload">
                                        <p2:EnableDigitalInputs>Input0 Input1 Input2</p2:EnableDigitalInputs>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateInput0OpModePayload">
                                        <p2:Input0OpMode>StopMotor0OnFalling</p2:Input0OpMode>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateInput1OpModePayload">
                                        <p2:Input1OpMode>StopMotor1OnFalling</p2:Input1OpMode>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateInput2OpModePayload">
                                        <p2:Input2OpMode>StopMotor2OnFalling</p2:Input2OpMode>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="IntProperty">
                                        <Value>25</Value>
                                      </Combinator>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="Motor0StepInterval" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor0StepIntervalPayload">
                                        <p2:Motor0StepInterval>200</p2:Motor0StepInterval>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="Motor1StepInterval" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor1StepIntervalPayload">
                                        <p2:Motor1StepInterval>200</p2:Motor1StepInterval>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="PropertyMapping">
                                      <PropertyMappings>
                                        <Property Name="Motor2StepInterval" />
                                      </PropertyMappings>
                                    </Expression>
                                    <Expression xsi:type="p2:CreateMessage">
                                      <harp:MessageType>Write</harp:MessageType>
                                      <harp:Payload xsi:type="p2:CreateMotor2StepIntervalPayload">
                                        <p2:Motor2StepInterval>200</p2:Motor2StepInterval>
                                      </harp:Payload>
                                    </Expression>
                                    <Expression xsi:type="Combinator">
                                      <Combinator xsi:type="rx:Concat" />
                                    </Expression>
                                    <Expression xsi:type="MulticastSubject">
                                      <Name>StepperDriver1Commands</Name>
                                    </Expression>
                                    <Expression xsi:type="WorkflowOutput" />
                                  </Nodes>
                                  <Edges>
                                    <Edge From="1" To="25" Label="Source1" />
                                    <Edge From="2" To="25" Label="Source2" />
                                    <Edge From="3" To="25" Label="Source3" />
                                    <Edge From="4" To="25" Label="Source4" />
                                    <Edge From="5" To="25" Label="Source5" />
                                    <Edge From="6" To="25" Label="Source6" />
                                    <Edge From="7" To="25" Label="Source7" />
                                    <Edge From="8" To="25" Label="Source8" />
                                    <Edge From="9" To="25" Label="Source9" />
                                    <Edge From="10" To="25" Label="Source10" />
                                    <Edge From="11" To="25" Label="Source11" />
                                    <Edge From="12" To="25" Label="Source12" />
                                    <Edge From="13" To="25" Label="Source13" />
                                    <Edge From="14" To="25" Label="Source14" />
                                    <Edge From="15" To="25" Label="Source15" />
                                    <Edge From="16" To="25" Label="Source16" />
                                    <Edge From="17" To="25" Label="Source17" />
                                    <Edge From="18" To="19" Label="Source1" />
                                    <Edge From="18" To="21" Label="Source1" />
                                    <Edge From="18" To="23" Label="Source1" />
                                    <Edge From="19" To="20" Label="Source1" />
                                    <Edge From="20" To="25" Label="Source18" />
                                    <Edge From="21" To="22" Label="Source1" />
                                    <Edge From="22" To="25" Label="Source19" />
                                    <Edge From="23" To="24" Label="Source1" />
                                    <Edge From="24" To="25" Label="Source20" />
