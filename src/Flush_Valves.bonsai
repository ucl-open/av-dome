                              <Edge From="16" To="18" Label="Source1" />
                              <Edge From="17" To="18" Label="Source2" />
                              <Edge From="18" To="19" Label="Source1" />
                              <Edge From="18" To="20" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>ZEROMotors</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="Annotation">
                                <Name>Need to give motors time to reach ZERO before moving again</Name>
                                <Text><![CDATA[Need to give motors time to reach ZERO before moving again]]></Text>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Timer">
                                  <rx:DueTime>PT4S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="rx:SelectMany">
                                <Name>SendSpoutInCommand</Name>
                                <Workflow>
                                  <Nodes>
                                    <Expression xsi:type="Annotation">
                                      <Name>MoveToInPosition</Name>
                                      <Text><![CDATA[MoveToInPosition]]></Text>
                                    </Expression>
                                    <Expression xsi:type="SubscribeSubject">
                                      <Name>StepperPosition_BothIn</Name>
                                    </Expression>
                                    <Expression xsi:type="MulticastSubject">
                                      <Name>StepperPositionCommand</Name>
                                    </Expression>
                                  </Nodes>
                                  <Edges>
                                    <Edge From="0" To="1" Label="Source1" />
                                    <Edge From="1" To="2" Label="Source1" />
                                  </Edges>
                                </Workflow>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor0_switchState</SubjectName_switchState>
                                <MotorID>0</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor0_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor1_switchState</SubjectName_switchState>
                                <MotorID>1</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor1_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor2_switchState</SubjectName_switchState>
                                <MotorID>2</MotorID>
                                <SubjectName_StepperDriver>StepperDriver1Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor2_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor3_switchState</SubjectName_switchState>
                                <MotorID>0</MotorID>
                                <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor3_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\ZEROingMotors.bonsai">
                                <SubjectName_switchState>_Motor4_switchState</SubjectName_switchState>
                                <MotorID>1</MotorID>
                                <SubjectName_StepperDriver>StepperDriver2Commands</SubjectName_StepperDriver>
                                <SubjectName_switchState_again>_Motor4_switchState</SubjectName_switchState_again>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Zip" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:SubscribeWhen" />
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="rx:Delay">
                                  <rx:DueTime>PT2S</rx:DueTime>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="9" Label="Source1" />
                              <Edge From="3" To="8" Label="Source1" />
                              <Edge From="4" To="8" Label="Source2" />
                              <Edge From="5" To="8" Label="Source3" />
                              <Edge From="6" To="8" Label="Source4" />
                              <Edge From="7" To="8" Label="Source5" />
                              <Edge From="8" To="9" Label="Source2" />
                              <Edge From="9" To="10" Label="Source1" />
                              <Edge From="10" To="11" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>MoveMotors</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>StepperPositionCommand</Name>
                              </Expression>
                              <Expression xsi:type="IncludeWorkflow" Path="Extensions\MoveStepperMotors.bonsai" />
                              <Expression xsi:type="Disable">
                                <Builder xsi:type="rx:BehaviorSubject" />
                              </Expression>
                              <Expression xsi:type="Disable">
                                <Builder xsi:type="rx:BehaviorSubject" />
                              </Expression>
                              <Expression xsi:type="Disable">
                                <Builder xsi:type="rx:BehaviorSubject" />
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="3" To="4" Label="Source1" />
                            </Edges>
                          </Workflow>
                        </Expression>
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="1" Label="Source1" />
                        <Edge From="1" To="2" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                  <Expression xsi:type="GroupWorkflow">
                    <Name>Audio</Name>
                    <Workflow>
                      <Nodes>
                        <Expression xsi:type="GroupWorkflow">
                          <Name>MixerDevice</Name>
                          <Workflow>
                            <Nodes>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p3:CreateMixerContext">
                                  <p3:HostApi>Windows WDM-KS</p3:HostApi>
                                  <p3:DeviceName>Speakers (XMOS xCORE-200 MC (UAC2.0))</p3:DeviceName>
                                  <p3:SampleRate>48000</p3:SampleRate>
                                  <p3:ChannelCount xsi:nil="true" />
                                  <p3:SuggestedLatency>0.002</p3:SuggestedLatency>
                                </Combinator>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p3:StartMixer" />
                              </Expression>
                              <Expression xsi:type="rx:BehaviorSubject">
                                <Name>Mixer</Name>
                              </Expression>
                              <Expression xsi:type="WorkflowOutput" />
                              <Expression xsi:type="rx:BehaviorSubject" TypeArguments="p4:Mat">
                                <rx:Name>MixerBuffer</rx:Name>
                              </Expression>
                              <Expression xsi:type="SubscribeSubject">
                                <Name>Mixer</Name>
                              </Expression>
                              <Expression xsi:type="Combinator">
                                <Combinator xsi:type="p3:PlayBuffer" />
                              </Expression>
                            </Nodes>
                            <Edges>
                              <Edge From="0" To="1" Label="Source1" />
                              <Edge From="1" To="2" Label="Source1" />
                              <Edge From="2" To="3" Label="Source1" />
                              <Edge From="4" To="6" Label="Source1" />
                              <Edge From="5" To="6" Label="Source2" />
                            </Edges>
                          </Workflow>
                        </Expression>
                        <Expression xsi:type="Annotation">
                          <Name>Any errors during boot up can cause blue screens, so we delay this a bit</Name>
                          <Text><![CDATA[Any errors during boot up can cause blue screens, so we delay this a bit]]></Text>
                        </Expression>
                        <Expression xsi:type="Combinator">
                          <Combinator xsi:type="rx:DelaySubscription">
                            <rx:DueTime>PT3S</rx:DueTime>
                          </Combinator>
                        </Expression>
                        <Expression xsi:type="WorkflowOutput" />
                      </Nodes>
                      <Edges>
                        <Edge From="0" To="2" Label="Source1" />
                        <Edge From="1" To="2" Label="Source2" />
                        <Edge From="2" To="3" Label="Source1" />
                      </Edges>
                    </Workflow>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="6" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                  <Edge From="3" To="6" Label="Source2" />
                  <Edge From="4" To="5" Label="Source1" />
                  <Edge From="5" To="6" Label="Source3" />
                </Edges>
              </Workflow>
            </Expression>
          </Nodes>
          <Edges />
        </Workflow>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>GUI</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="gui:LabelBuilder">
              <gui:Name>Left</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>Left</gui:Text>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:LabelBuilder">
              <gui:Name>Right</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>Right</gui:Text>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="Annotation">
              <Name>Motor1 UP</Name>
              <Text><![CDATA[Motor1 UP]]></Text>
            </Expression>
            <Expression xsi:type="gui:ButtonBuilder">
              <gui:Name>Left UP</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>↑</gui:Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_UP</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="SubscribeSubject">
              <Name>StepperPosition_BothIn</Name>
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0},{1},{2},{3},{4};</Format>
              <Selector>Item1,Item2,Item3,Item4,Item5</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Text" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="gui:LabelBuilder">
              <gui:Name>BLANK</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>0,0,0,0,0;</gui:Text>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:ButtonBuilder">
              <gui:Name>Right UP</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>↑</gui:Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_UP</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="Annotation">
              <Name>Motor1 DOWN</Name>
              <Text><![CDATA[Motor1 DOWN]]></Text>
            </Expression>
            <Expression xsi:type="gui:ButtonBuilder">
              <gui:Name>Left DOWN</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>↓</gui:Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor4_DOWN</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:LabelBuilder">
              <gui:Name>BLANK</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text />
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:ButtonBuilder">
              <gui:Name>Right DOWN</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>↓</gui:Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor5_DOWN</Name>
            </Expression>
            <Expression xsi:type="VisualizerMapping" />
            <Expression xsi:type="gui:ButtonBuilder">
              <gui:Name>Left FRONT</gui:Name>
              <gui:Enabled>true</gui:Enabled>
              <gui:Visible>true</gui:Visible>
              <gui:Text>↙</gui:Text>
            </Expression>
            <Expression xsi:type="rx:PublishSubject">
              <Name>Motor2_UP</Name>
