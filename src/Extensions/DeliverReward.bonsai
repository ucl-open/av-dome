<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Description>Delivers each reward command, a (side, microlitres) pair with 1 the left side and 2 the right, on that side's reward line, the line rig.yml's rewardValves gives it: plans the pulses from the line's valve calibration (or its fixed width), fires them through TriggerCalibratedPulse with the rig's inter-pulse interval on harp time, and publishes every plan on RewardDelivered. The Logging group writes each plan as a RewardDelivered row of BonsaiData_Async (Detail starting with its side and line, Value the microlitres delivered), which rig-control counts as water; the pulse widths and valve triggers themselves are in the behavior board's harp log.</Description>
  <Workflow>
    <Nodes>
      <Expression xsi:type="WorkflowInput">
        <Name>Source1</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RewardLineLeft</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RewardLineRight</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>RigConfigs</Name>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="InterPulseIntervalMs" Selector="InterPulseInterval" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:PlanReward">
          <p1:InterPulseIntervalMs>50</p1:InterPulseIntervalMs>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:SelectMany">
        <Name>DeliverPulses</Name>
        <Description>Fires the plan's pulses: each repetition writes the width and sets the line, then waits width plus inter-pulse interval on harp time.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>plan</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>plan</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Trigger</Selector>
            </Expression>
            <Expression xsi:type="MulticastSubject">
              <Name>TriggerCalibratedPulse</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>plan</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:WithLatestFrom" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Item2.PeriodSeconds</Selector>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\HarpDelayByInput.bonsai" />
            <Expression xsi:type="SubscribeSubject">
              <Name>plan</Name>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Count</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Count" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:RepeatCount">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="7" Label="Source1" />
            <Edge From="6" To="7" Label="Source2" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="13" Label="Source1" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source2" />
            <Edge From="13" To="14" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
      <Expression xsi:type="rx:BehaviorSubject">
        <Name>RewardDelivered</Name>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="4" Label="Source1" />
      <Edge From="1" To="3" Label="Source1" />
      <Edge From="2" To="3" Label="Source2" />
      <Edge From="3" To="4" Label="Source2" />
      <Edge From="4" To="7" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source2" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="7" To="10" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
