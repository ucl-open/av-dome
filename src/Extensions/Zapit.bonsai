<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Host" Description="Host name or IP address of the PC running Zapit." />
        <Property Name="Port" Description="TCP port of the Zapit server (1488 by default)." />
        <Property Name="ReceiveTimeout" Description="Milliseconds to wait for a Zapit reply before failing." />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>ZapitCommands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
          <rx:DueTime>PT0S</rx:DueTime>
          <rx:Period>PT0S</rx:Period>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:CreateZapitQuery">
          <p1:Query>IsStimConfigLoaded</p1:Query>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:CreateZapitQuery">
          <p1:Query>GetNumConditions</p1:Query>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:ZapitClient">
          <p1:Host>127.0.0.1</p1:Host>
          <p1:Port>1488</p1:Port>
          <p1:ReceiveTimeout>5000</p1:ReceiveTimeout>
        </Combinator>
      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>ZapitReplies</Name>
      </Expression>
      <Expression xsi:type="rx:Condition">
        <Name>NoStimConfigLoaded?</Name>
        <Description>Passes the IsStimConfigLoaded reply only when Zapit answered 0, so the session fails at startup instead of stimulating nothing.</Description>
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="scr:ExpressionTransform">
              <scr:Expression>CommandCode == 2 &amp;&amp; Value == 0</scr:Expression>
            </Expression>
            <Expression xsi:type="WorkflowOutput" />
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Format">
        <Format>Zapit has no stimulus configuration loaded (IsStimConfigLoaded returned {0}). Load a stim config in Zapit, then restart the workflow.</Format>
        <Selector>Value</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:ThrowError" />
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="6" Label="Source2" />
      <Edge From="1" To="5" Label="Source1" />
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="2" To="4" Label="Source1" />
      <Edge From="3" To="5" Label="Source2" />
      <Edge From="4" To="5" Label="Source3" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="7" To="11" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
